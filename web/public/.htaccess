# BIA JUPEB — Apache / LiteSpeed configuration (cPanel hosting).
# Replaces what vercel.json did on Vercel. Copied into dist/ by the build.
# Canonical address: https://biajupeb.com.ng — no www, no trailing slash (except "/").

Options -Indexes -MultiViews
DirectoryIndex index.html
# Serve /fees from fees/index.html without adding a slash (the canonical form has none).
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. One canonical host: www.biajupeb.com.ng -> biajupeb.com.ng (and to HTTPS), in one hop.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# 2. HTTPS everywhere (X-Forwarded-Proto covers hosts behind a proxy/CDN).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# 3. Old V1 addresses (kept in step with vercel.json). THE_REQUEST matches only what the
#    visitor typed, so internal index.html look-ups never loop.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/jupeb\-guide\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/guides/jupeb-guide [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/jupeb\-unilag\-admission\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/guides/jupeb-unilag-admission [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/jupeb\-vs\-ijmb\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/guides/jupeb-vs-ijmb [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/awaiting\-result\-jupeb\-2026\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/guides/awaiting-result-jupeb-2026 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/jupeb\-past\-questions\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/guides/jupeb-past-questions [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/jupeb\-info\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/#programme [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/classes\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/#programme [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/special\-class\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/#programme [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/about\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/about [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/contact\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/#apply [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/signup\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/#apply [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/signin\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/#apply [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/result\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/success-stories [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/admin\-results\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/profile\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/edit\-profile\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/private\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/keep\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/text\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,NE]

# 4. One address per page: /fees/ -> /fees (the homepage "/" is left alone).
RewriteCond %{THE_REQUEST} \s/([^?\s]+?)/+(\?[^\s]*)?\s
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]

# 5. Clean URLs: /fees -> fees/index.html (internal, the address bar keeps /fees).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# Media types some servers do not know yet.
AddType image/avif .avif
AddType image/webp .webp
AddType text/vtt .vtt
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddDefaultCharset utf-8

# Compression for text files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/vtt application/javascript text/javascript application/json application/xml image/svg+xml application/ld+json
</IfModule>

# Caching: hashed build files (/_astro/, images, CSS, JS, fonts) never change -> 1 year.
# HTML, sitemap, robots and ads.txt must refresh quickly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/vtt "access plus 1 month"
</IfModule>

# Security headers (Vercel sent HSTS; keep it).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
