---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { address, contacts, email, site } from '../data/site';
import lockup from '../assets/brand/bia-lockup.svg';
import { ads, adsEnabled } from '../data/ads';

interface Props {
  title: string;
  description: string;
  /** Exclude this page from search engines (e.g. the 404 page). */
  noindex?: boolean;
  /** Page runs the GSAP motion layer (enables the hero pre-hide). */
  motion?: boolean;
  /** Page opens on a full-bleed photograph: the header starts transparent over it. */
  overlayHeader?: boolean;
}

const { title, description, noindex = false, motion = false, overlayHeader = false } = Astro.props;
// One URL per page, matching the sitemap and internal links: no trailing slash (except the homepage).
// The host serves both /fees and /fees/; the canonical tells search engines which one to index.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/+$/, '$1'), site.url).href;
// AdSense script and site-verification tag: only once a publisher ID is configured, never on noindex pages.
const loadAds = adsEnabled && !noindex;
// Structured data: the confirmed centre address and official contacts.
const org = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'BIA JUPEB',
  alternateName: site.parent,
  description: `${site.parent} — ${site.descriptor}. JUPEB preparation for Science and Non-Science students.`,
  url: site.url,
  logo: new URL(lockup.src, site.url).href,
  telephone: contacts.map((c) => c.phone),
  email,
  address: {
    '@type': 'PostalAddress',
    name: address.name,
    streetAddress: address.street,
    addressLocality: address.locality,
    addressRegion: address.region,
    addressCountry: 'NG',
  },
  sameAs: [site.facebook, site.tiktok],
};
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#d80000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:site_name" content="BIA JUPEB" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {loadAds && <meta name="google-adsense-account" content={ads.client} />}
    {loadAds && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`}
        crossorigin="anonymous"
      ></script>
    )}
    {
      motion && (
        <script is:inline>
          (function () {
            var d = document.documentElement;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            d.classList.add('js-motion');
            // Failsafe: never leave content hidden if the motion script fails to start.
            setTimeout(function () {
              if (d.dataset.motion !== 'running') d.classList.remove('js-motion');
            }, 3000);
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
