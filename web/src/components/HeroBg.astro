---
/**
 * Decorative background photograph for a page header, under a wash in the
 * header's own colour (BIA red or ink) so text keeps its contrast.
 * The parent section must be position: relative; this sits behind it (z-index -1)
 * and the parent gets `isolation: isolate` from the global rule below.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** CSS object-position, e.g. "center 40%". */
  position?: string;
  tone?: 'red' | 'ink';
}
const { src, position = 'center', tone = 'red' } = Astro.props;
---

<div class:list={['herobg', `herobg--${tone}`]} data-clip aria-hidden="true">
  <Picture src={src} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="100vw" alt="" loading="eager" style={`object-position:${position}`} />
</div>

<style>
  .herobg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  :global(:has(> .herobg)) {
    isolation: isolate;
  }
  .herobg :global(picture),
  .herobg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .herobg :global(img) {
    object-fit: cover;
  }
  .herobg::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .herobg--red::after {
    background: linear-gradient(180deg, rgb(200 0 0 / 0.86) 0%, rgb(170 0 0 / 0.9) 100%);
  }
  .herobg--ink::after {
    background: radial-gradient(ellipse at 50% 45%, rgb(21 23 30 / 0.74) 0%, rgb(21 23 30 / 0.9) 70%, rgb(21 23 30 / 0.95) 100%);
  }
</style>
