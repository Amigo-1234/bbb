---
/** Line illustrations for the two JUPEB streams. Drawn for this site. */
interface Props {
  stream: 'science' | 'non-science';
}
const { stream } = Astro.props;
---

{
  stream === 'science' ? (
    <svg class="art" viewBox="0 0 200 140" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        {/* conical flask */}
        <path d="M70 24h28M76 24v34L48 112a8 8 0 0 0 7 12h58a8 8 0 0 0 7-12L92 58V24" />
        <path class="art__fill" d="M60 90h48l12 22a8 8 0 0 1-7 12H55a8 8 0 0 1-7-12Z" />
        <circle cx="72" cy="104" r="3" />
        <circle cx="88" cy="98" r="2" />
        <circle cx="96" cy="110" r="2.5" />
        {/* atom */}
        <ellipse cx="150" cy="52" rx="30" ry="11" />
        <ellipse cx="150" cy="52" rx="30" ry="11" transform="rotate(60 150 52)" />
        <ellipse cx="150" cy="52" rx="30" ry="11" transform="rotate(-60 150 52)" />
        <circle class="art__dot" cx="150" cy="52" r="4" />
        {/* measuring marks */}
        <path d="M134 112h44M138 104v8M146 108v4M154 104v8M162 108v4M170 104v8" />
      </g>
    </svg>
  ) : (
    <svg class="art" viewBox="0 0 200 140" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        {/* open book */}
        <path d="M24 112c18-8 40-8 58 0V56c-18-8-40-8-58 0Z" />
        <path d="M82 112c18-8 40-8 58 0V56c-18-8-40-8-58 0Z" />
        <path d="M34 70c12-4 26-4 38 0M34 82c12-4 26-4 38 0M34 94c12-4 26-4 38 0" />
        <path d="M92 70c12-4 26-4 38 0M92 82c12-4 26-4 38 0" />
        {/* rising chart — commercial */}
        <path class="art__line" d="M120 46l14-12 12 6 22-22" />
        <circle class="art__dot" cx="168" cy="18" r="3.5" />
        <path d="M160 18h8v8" />
        {/* column — arts & humanities */}
        <path d="M156 112V62M176 112V62M152 62h28M150 56h32l-16-10Z M150 112h32" />
        <path d="M162 66v42M170 66v42" />
      </g>
    </svg>
  )
}

<style>
  .art {
    width: 100%;
    max-width: 220px;
    height: auto;
    color: var(--ink);
  }
  .art__fill {
    fill: var(--crimson-wash);
    stroke: var(--crimson);
  }
  .art__dot {
    fill: var(--crimson);
    stroke: var(--crimson);
  }
  .art__line {
    stroke: var(--crimson);
  }
</style>
