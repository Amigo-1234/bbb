---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import { address, contacts, guides, office, primaryContact, site, whatsapp } from '../data/site';
---

<footer class="footer" data-cta-zone>
  <div class="footer__band">
    <div class="wrap footer__band-inner">
      <Badge variant="seal" size={92} tone="light" />
      <p class="footer__band-text">
        <span class="footer__band-name">{site.parent}</span>
        <span>{site.descriptor}</span>
      </p>
    </div>
  </div>
  <Badge variant="mark" size={520} class="footer__watermark" />
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <div class="footer__mark">
        <Logo height={40} tone="light" />
        <span>
          <span class="footer__name">BIA JUPEB</span>
          <span class="footer__parent">{site.parent}</span>
        </span>
      </div>
      <p class="footer__line">
        A JUPEB academy and tutorial centre preparing Science and Non-Science students for Direct Entry into 200 Level.
      </p>
    </div>

    <div>
      <h2 class="footer__h">Visit</h2>
      <address>
        <strong>Tutorial Centre</strong>
        <span>{address.short}</span>
        <span class="footer__muted">Landmark: {address.landmark}</span>
      </address>
      <a class="footer__link with-icon" href="/#location"><Icon name="pin" size={16} />Directions &amp; video</a>
      <address class="footer__office">
        <strong>Administrative Office</strong>
        <span>{office.short}</span>
        <span class="footer__muted">{office.landmark}</span>
      </address>
    </div>

    <div>
      <h2 class="footer__h">Admissions</h2>
      <ul class="footer__list">
        {contacts.map((c) => (
          <li>
            <a href={`tel:${c.phone}`} class="num">{c.display}</a>
            <span class="footer__muted">{c.name ? `${c.name} · ${c.role}` : c.role}</span>
          </li>
        ))}
        <li><a href={whatsapp} rel="noopener" target="_blank">WhatsApp {primaryContact.display}</a></li>
        <li><a class="footer__link with-icon" href="/contact" data-cta="footer-contact">All staff contacts<Icon name="arrow-right" size={16} /></a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__h">Explore</h2>
      <ul class="footer__list">
        <li><a href="/success-stories">Success stories</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/fees">Fees &amp; payment</a></li>
        <li><a href="/timetable">Class timetable</a></li>
        {guides.map((g) => <li><a href={g.href}>{g.title}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="wrap footer__base">
    <p>© {new Date().getFullYear()} BIA JUPEB · {site.parent}</p>
    <p class="footer__social">
      <a class="with-icon" href={site.facebook} rel="noopener" target="_blank"><Icon name="facebook" size={16} />Facebook</a>
      <a href={site.tiktok} rel="noopener" target="_blank">TikTok @bomaacademylimited</a>
    </p>
  </div>
</footer>

<nav class="actionbar" aria-label="Quick actions" data-actionbar>
  <a class="btn btn--outline actionbar__call" href={`tel:${primaryContact.phone}`} data-cta="actionbar-call"><Icon name="phone" size={18} />Call admissions</a>
  <a class="btn" href="/#apply" data-cta="actionbar-apply">Enquire<Icon name="arrow-right" size={18} /></a>
</nav>

<script>
  // Show the quick-action bar only when no other admissions call-to-action is on screen.
  const bar = document.querySelector<HTMLElement>('[data-actionbar]');
  const zones = document.querySelectorAll('[data-cta-zone]');
  if (bar && zones.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target));
      bar.toggleAttribute('data-hidden', visible.size > 0);
    });
    zones.forEach((z) => io.observe(z));
  }
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-ink);
    padding-bottom: var(--s-6);
    font-size: 0.95rem;
  }
  .footer__band {
    background: var(--bia-red-deep);
    color: var(--on-red);
    margin-bottom: var(--s-8);
  }
  .footer__band-inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
  }
  .footer__band-text {
    display: grid;
    gap: 2px;
    font-size: var(--step--1);
    color: var(--on-red-muted);
  }
  .footer__band-name {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.1;
    color: #fff;
  }
  .footer :global(.footer__watermark) {
    position: absolute;
    right: -120px;
    bottom: -60px;
    width: 520px;
    height: auto;
    color: #fff;
    opacity: 0.035;
    pointer-events: none;
  }
  .footer__grid,
  .footer__base {
    position: relative;
  }
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .footer__social a {
    color: var(--on-ink);
  }
  .footer a {
    text-decoration-color: rgb(255 255 255 / 0.3);
  }
  .footer a:hover {
    text-decoration-color: currentColor;
  }
  .footer__grid {
    display: grid;
    gap: var(--s-7);
  }
  .footer__mark {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .footer__mark > span {
    display: grid;
    line-height: 1.2;
    padding-left: var(--s-3);
    border-left: 1px solid rgb(255 255 255 / 0.18);
  }
  .footer__name {
    font-family: var(--serif);
    font-size: 1.35rem;
  }
  .footer__parent,
  .footer__muted {
    color: var(--on-ink-muted);
    font-size: 0.85rem;
  }
  .footer__line {
    margin-top: var(--s-4);
    max-width: 34ch;
    color: var(--on-ink-muted);
  }
  .footer__h {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    margin-bottom: var(--s-3);
  }
  address strong {
    font-weight: 700;
  }
  address {
    display: grid;
    font-style: normal;
    margin-bottom: var(--s-3);
  }
  .footer__link {
    font-weight: 600;
  }
  .footer__office {
    margin-top: var(--s-5);
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .footer__list li {
    display: grid;
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: var(--on-ink-muted);
    font-size: 0.85rem;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    }
  }

  /* Mobile quick-action bar */
  .actionbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-2);
    padding: var(--s-2) var(--gutter) calc(var(--s-2) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .actionbar .btn {
    min-width: 0;
    padding-inline: var(--s-3);
  }
  .actionbar__call {
    background: var(--surface);
  }
  .actionbar {
    transition: transform 0.35s var(--ease), visibility 0.35s;
  }
  /* Hidden while on-page admissions buttons are visible, so it never covers them */
  .actionbar[data-hidden] {
    transform: translateY(110%);
    visibility: hidden;
  }
  @media (max-width: 359px) {
    .actionbar .btn :global(svg) {
      display: none;
    }
  }
  @media (max-width: 719px) {
    :global(body) {
      padding-bottom: calc(64px + env(safe-area-inset-bottom));
    }
  }
  @media (min-width: 720px) {
    .actionbar {
      display: none;
    }
  }
</style>
