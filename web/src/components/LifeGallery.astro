---
/**
 * "Life at BIA": an editorial photo mosaic with an accessible lightbox.
 * Thumbnails are responsive and lazy; the large version (1600px WebP) is only
 * fetched when a visitor opens a photo. Every tile is a real link, so it works
 * without JavaScript.
 */
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../data/media';

interface Props {
  photos: Photo[];
  label: string;
}
const { photos, label } = Astro.props;
const large = await Promise.all(photos.map((p) => getImage({ src: p.src, format: 'webp', width: Math.min(p.src.width, 1600) })));
---

<div class="life" data-life>
  <ul class="life__grid" aria-label={label} data-count={photos.length}>
    {
      photos.map((p, i) => (
        <li class="life__item">
          <a
            class="life__link"
            href={large[i].src}
            data-life-open={i}
            data-w={large[i].attributes.width}
            data-h={large[i].attributes.height}
            data-alt={p.alt}
            data-caption={p.caption}
            target="_blank"
            rel="noopener"
          >
            <Picture
              src={p.src}
              formats={['avif', 'webp']}
              widths={[360, 640, 960]}
              sizes={i === 0 ? '(min-width: 960px) 50vw, 100vw' : '(min-width: 960px) 25vw, 50vw'}
              alt={p.alt}
              loading="lazy"
              style={p.position ? `object-position:${p.position}` : undefined}
            />
            <span class="life__cap">{p.caption}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="life__dialog" aria-label="Photograph">
    <figure>
      <img data-life-img alt="" width="1600" height="1200" decoding="async" />
      <figcaption>
        <span data-life-caption></span>
        <span class="life__count num" data-life-count></span>
      </figcaption>
    </figure>
    <button type="button" class="life__btn life__close" data-life-close aria-label="Close photograph">×</button>
    <button type="button" class="life__btn life__prev" data-life-prev aria-label="Previous photograph">‹</button>
    <button type="button" class="life__btn life__next" data-life-next aria-label="Next photograph">›</button>
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-life]')) {
    const dialog = root.querySelector('dialog');
    if (!dialog || typeof dialog.showModal !== 'function') continue;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-life-open]')];
    const img = dialog.querySelector<HTMLImageElement>('[data-life-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-life-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-life-count]')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${links.length}`;
    };
    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-life-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-life-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-life-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('close', () => links[index]?.focus());
  }
</script>

<style>
  .life__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 9.5rem;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .life__item:first-child {
    grid-column: 1 / -1;
    grid-row: span 2;
  }
  /* 1 large + an odd number of tiles: let the last tile close the row */
  .life__item:last-child:nth-child(even) {
    grid-column: 1 / -1;
  }
  .life__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-2);
  }
  .life__link :global(picture),
  .life__link :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .life__link :global(img) {
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .life__link:hover :global(img),
  .life__link:focus-visible :global(img) {
    transform: scale(1.05);
  }
  .life__cap {
    position: absolute;
    left: var(--s-2);
    bottom: var(--s-2);
    max-width: calc(100% - var(--s-4));
    padding: 0.25em 0.6em;
    background: rgb(255 255 255 / 0.92);
    color: var(--ink);
    border-radius: 2px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  @media (min-width: 960px) {
    .life__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 14rem;
      gap: var(--s-3);
    }
    .life__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .life__item:last-child:nth-child(even) {
      grid-column: auto;
    }
    /* four photographs: large, tall, then two stacked */
    .life__grid[data-count='4'] {
      grid-template-columns: 2fr 1fr 1fr;
    }
    .life__grid[data-count='4'] .life__item:first-child {
      grid-column: auto;
    }
    .life__grid[data-count='4'] .life__item:nth-child(2) {
      grid-row: span 2;
    }
    .life__grid[data-count='4'] .life__item:nth-child(3) {
      grid-column: 3;
    }
    .life__grid[data-count='4'] .life__item:nth-child(4) {
      grid-column: 3;
      grid-row: 2;
    }
    .life__cap {
      font-size: var(--step--1);
    }
  }

  .life__dialog {
    width: min(100vw - 1rem, 1100px);
    max-height: calc(100dvh - 1rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--on-ink);
    overflow: hidden;
  }
  .life__dialog::backdrop {
    background: rgb(21 23 30 / 0.85);
  }
  .life__dialog figure {
    margin: 0;
  }
  .life__dialog img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 5rem);
    object-fit: contain;
    background: #000;
  }
  .life__dialog figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    font-size: var(--step--1);
  }
  .life__btn {
    position: absolute;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgb(21 23 30 / 0.7);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .life__btn:hover {
    background: var(--bia-red);
  }
  .life__close {
    top: var(--s-2);
    right: var(--s-2);
  }
  .life__prev,
  .life__next {
    top: 40%;
  }
  .life__prev {
    left: var(--s-2);
  }
  .life__next {
    right: var(--s-2);
  }
</style>
