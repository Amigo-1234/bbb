---
/**
 * The official BIA lockup (symbol + wordmark), traced from the high-resolution
 * logo embedded in BIA's 2026/27 payment advice PDFs. Rendered as a CSS mask so
 * it can take BIA red or white without redrawing the logo.
 */
import mark from '../assets/brand/bia-lockup.svg';

interface Props {
  height?: number;
  tone?: 'crimson' | 'red' | 'light';
  class?: string;
}
const { height = 34, tone = 'crimson', class: className } = Astro.props;
const width = Math.round((height * mark.width) / mark.height);
---

<span
  class:list={['logo', `logo--${tone}`, className]}
  role="img"
  aria-label="BIA"
  style={`--mark:url(${mark.src});width:${width}px;height:${height}px`}
></span>

<style>
  .logo {
    display: inline-block;
    flex: none;
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }
  .logo--crimson {
    color: var(--crimson);
  }
  .logo--red {
    color: var(--bia-red);
  }
  .logo--light {
    color: var(--on-ink);
  }
</style>
