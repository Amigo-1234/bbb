---
/** The two ways to study with BIA, as signposts: A (full programme) and B (tutorials only). */
import { naira, registration, tutorialPackage } from '../data/fees';
interface Props {
  /** Path prefix for the anchors ('' on the same page). */
  base?: string;
  cta: string;
}
const { base = '', cta } = Astro.props;
---

<nav class="paths" aria-label="Fee options">
  <a href={`${base}#programme-fees`} class="paths__item" data-cta={`${cta}-path-programme`}>
    <span class="paths__badge">A</span>
    <span>
      <strong>Full JUPEB admission programme</strong>
      <small>Science · Non-Science · registration {naira(registration.amount)}</small>
    </span>
  </a>
  <a href={`${base}#tutorials`} class="paths__item" data-cta={`${cta}-path-tutorials`}>
    <span class="paths__badge">B</span>
    <span>
      <strong>Physical tutorials only</strong>
      <small>Including students from other institutions · from {naira(tutorialPackage.monthly.amount)}/month</small>
    </span>
  </a>
</nav>

<style>
  .paths {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-7);
  }
  .paths__item {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 48px;
    padding: var(--s-4) var(--s-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .paths__item:hover {
    border-color: var(--crimson);
    transform: translateY(-2px);
  }
  .paths__item strong {
    display: block;
  }
  .paths__item small {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .paths__badge {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--crimson);
    color: #fff;
    font-family: var(--serif);
    font-size: 1.1rem;
  }
  @media (min-width: 720px) {
    .paths {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
