---
interface Props {
  size?: number;
  tone?: 'crimson' | 'light';
}
const { size = 36, tone = 'crimson' } = Astro.props;
---

<svg
  class:list={['seal', `seal--${tone}`]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
>
  <circle cx="24" cy="24" r="23" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
  <circle cx="24" cy="24" r="19.5" fill="none" stroke="currentColor" stroke-width="0.6"></circle>
  <text
    x="24"
    y="29.2"
    text-anchor="middle"
    font-family="Newsreader Variable, Georgia, serif"
    font-size="14.5"
    font-weight="560"
    letter-spacing="0.6"
    fill="currentColor">BIA</text
  >
</svg>

<style>
  .seal {
    flex: none;
  }
  .seal--crimson {
    color: var(--crimson);
  }
  .seal--light {
    color: var(--on-ink);
  }
</style>
