---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { calendar, primaryContact, site } from '../data/site';

const nav = [
  { label: 'Fees', href: '/fees' },
  { label: 'Timetable', href: '/timetable' },
  { label: 'Success stories', href: '/success-stories' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Location', href: '/#location' },
];

// Notice bar shows the next confirmed milestone, worked out at build time.
const today = new Date().toISOString().slice(0, 10);
const next = calendar.find((c) => !c.unconfirmed && (c.end ?? c.start) >= today);
const fmt = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Africa/Lagos',
  });
// An event already under way shows its end date instead of its start.
const nextWhen = next ? (next.end && next.start <= today ? 'until ' + fmt(next.end) : fmt(next.start)) : '';
---

<div class="notice">
  <div class="wrap notice__inner">
    <p>
      <span class="notice__session">{site.session} session</span>
      {next && (
        <span>
          <span class="notice__sep" aria-hidden="true">·</span>
          {next.label}: <strong>{nextWhen}</strong>
        </span>
      )}
    </p>
    <a href="/#calendar" class="notice__link">Full calendar</a>
  </div>
</div>

<header class="header" data-header>
  <div class="wrap header__inner">
    <a href="/" class="brand">
      <Logo height={30} tone="red" />
      <span class="brand__text">
        <span class="brand__name">JUPEB</span>
        <span class="brand__sub">Boma’s Intellectual Academy</span>
      </span>
      <span class="sr-only">— BIA JUPEB home</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={Astro.url.pathname === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__call with-icon" href={`tel:${primaryContact.phone}`} data-cta="header-call">
        <Icon name="phone" size={17} />
        <span class="sr-only">Call admissions on </span>{primaryContact.display}
      </a>
      <a class="btn header__apply" href="/#apply" data-cta="header-apply">Enquire</a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
      >
        <span class="menu-btn__label">Menu</span>
        <span class="menu-btn__icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

</header>

  <div class="sheet" id="mobile-menu" hidden data-menu>
  <nav class="wrap" aria-label="Mobile">
    <ol class="sheet__list">
      {nav.map((n, i) => (
        <li style={`--i:${i}`}>
          <a href={n.href} data-menu-link>
            <span class="sheet__num num">{String(i + 1).padStart(2, '0')}</span>
            {n.label}
          </a>
        </li>
      ))}
    </ol>
    <div class="sheet__foot">
      <a class="btn" href="/#apply" data-menu-link data-cta="menu-apply">Enquire about JUPEB admission</a>
      <a class="btn btn--outline" href={`tel:${primaryContact.phone}`} data-cta="menu-call"><Icon name="phone" size={18} />Call {primaryContact.display}</a>
    </div>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  let closeTimer = 0;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    header.toggleAttribute('data-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    clearTimeout(closeTimer);
    if (open) {
      header.removeAttribute('data-hidden');
      menu.style.setProperty('--sheet-top', `${header.getBoundingClientRect().bottom}px`);
      menu.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
    } else {
      menu.classList.remove('is-open');
      // Let the closing transition play before removing the sheet.
      closeTimer = window.setTimeout(() => (menu.hidden = true), 260);
    }
  };

  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      btn.focus();
    }
  });
  matchMedia('(min-width: 960px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Hide the header while reading downwards; bring it back on any upward scroll.
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    header.toggleAttribute('data-scrolled', y > 8);
    if (!header.hasAttribute('data-open')) {
      if (y > 480 && y > lastY + 6) header.setAttribute('data-hidden', '');
      else if (y < lastY - 6 || y <= 480) header.removeAttribute('data-hidden');
    }
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .notice {
    background: var(--bia-red);
    color: var(--on-red);
    font-size: var(--step--1);
  }
  .notice__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 40px;
    padding-block: var(--s-2);
  }
  .notice__session {
    color: var(--on-red-muted);
  }
  .notice__sep {
    margin-inline: 0.5em;
    color: var(--on-red-muted);
  }
  .notice strong {
    font-weight: 600;
  }
  .notice__link {
    flex: none;
    color: var(--on-red);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.5);
  }
  @media (max-width: 559px) {
    .notice__link {
      display: none;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease), transform 0.4s var(--ease);
  }
  .header[data-hidden]:not(:focus-within) {
    transform: translateY(-100%);
  }
  .header[data-scrolled],
  .header[data-open] {
    border-bottom-color: var(--line);
  }
  .header[data-open] {
    background: var(--paper);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    margin-right: auto;
  }
  .brand__text {
    display: grid;
    line-height: 1.05;
    padding-left: var(--s-3);
    border-left: 1px solid var(--line-strong);
  }
  .brand__name {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--bia-red);
  }
  .brand__sub {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    padding: var(--s-2) var(--s-3);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    border-radius: var(--radius);
  }
  .nav a {
    background: linear-gradient(currentColor, currentColor) left calc(100% - 4px) / 0 1px no-repeat;
    background-origin: content-box;
    transition: color 0.2s var(--ease), background-size 0.3s var(--ease);
  }
  .nav a[aria-current='page'] {
    color: var(--crimson);
    background-size: 100% 1px;
  }
  .nav a:hover,
  .nav a:focus-visible {
    color: var(--crimson);
    background-size: 100% 1px;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .header__call {
    display: none;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .header__call:hover {
    color: var(--crimson);
  }
  .header__apply {
    display: none;
    min-height: 42px;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-2) 0 var(--s-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: 600 0.9rem/1 var(--sans);
    cursor: pointer;
  }
  .menu-btn__icon {
    position: relative;
    width: 18px;
    height: 12px;
  }
  .menu-btn__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s var(--ease), top 0.2s var(--ease);
  }
  .menu-btn__icon span:first-child {
    top: 2px;
  }
  .menu-btn__icon span:last-child {
    top: 8px;
  }
  [aria-expanded='true'] .menu-btn__icon span:first-child {
    top: 5px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .menu-btn__icon span:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  .sheet {
    position: fixed;
    inset: var(--sheet-top, var(--header-h)) 0 0 0;
    z-index: 45;
    background: var(--paper);
    overflow-y: auto;
    padding-block: var(--s-5) var(--s-7);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .sheet.is-open {
    opacity: 1;
  }
  .sheet__list li,
  .sheet__foot {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.35s var(--ease) calc(var(--i, 0) * 45ms + 60ms),
      transform 0.45s var(--ease) calc(var(--i, 0) * 45ms + 60ms);
  }
  .sheet__foot {
    --i: 6;
  }
  .sheet.is-open .sheet__list li,
  .sheet.is-open .sheet__foot {
    opacity: 1;
    transform: none;
  }
  .sheet__list a:hover .sheet__num,
  .sheet__list a:focus-visible .sheet__num {
    transform: translateX(4px);
  }
  .sheet__num {
    transition: transform 0.25s var(--ease);
  }
  .sheet__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sheet__list a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: var(--step-3);
    line-height: 1.1;
    text-decoration: none;
  }
  .sheet__num {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
  }
  .sheet__foot {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  @media (min-width: 640px) {
    .header__apply {
      display: inline-flex;
    }
  }
  @media (min-width: 960px) {
    .nav {
      display: block;
    }
    .menu-btn {
      display: none;
    }
    .header__call {
      display: inline;
    }
    .brand {
      margin-right: 0;
    }
    .nav {
      margin-inline: auto;
    }
  }
  @media (min-width: 960px) and (max-width: 1100px) {
    .header__call {
      display: none;
    }
  }
</style>
