---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  id?: string;
  tone?: 'paper' | 'ink';
}
const { index, eyebrow, title, id, tone = 'paper' } = Astro.props;
---

<header class:list={['head', `head--${tone}`]}>
  <p class="head__label">
    <span class="head__index num">{index}</span>
    <span class="head__eyebrow">{eyebrow}</span>
  </p>
  <h2 id={id} class="head__title">{title}</h2>
  {Astro.slots.has('default') && <div class="head__intro"><slot /></div>}
</header>

<style>
  .head {
    display: grid;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
    margin-bottom: var(--s-7);
  }
  .head--ink {
    border-top-color: rgb(255 255 255 / 0.18);
  }
  .head__label {
    display: flex;
    gap: var(--s-3);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .head__index {
    color: var(--crimson);
  }
  .head--ink .head__index {
    color: #e8a3ad;
  }
  .head__eyebrow {
    color: var(--muted);
  }
  .head--ink .head__eyebrow {
    color: var(--on-ink-muted);
  }
  .head__title {
    font-size: var(--step-3);
    max-width: 20ch;
  }
  .head__intro {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--step-0);
  }
  .head--ink .head__intro {
    color: var(--on-ink-muted);
  }
  @media (min-width: 960px) {
    .head {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--s-6);
      align-items: start;
    }
    .head__label {
      grid-row: span 2;
      padding-top: 0.6em;
    }
  }
</style>
