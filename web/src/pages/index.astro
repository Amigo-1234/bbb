---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import {
  address,
  calendar,
  combinations,
  contacts,
  faqs,
  fees,
  gradePoints,
  guides,
  naira,
  outcomes,
  primaryContact,
  site,
} from '../data/site';
import classroom from '../assets/photos/classroom.png';
import founder from '../assets/photos/founder.png';
import founderTeaching from '../assets/photos/founder-teaching.jpg';
import centre from '../assets/photos/centre-entrance.jpg';

const today = new Date().toISOString().slice(0, 10);
const nextIndex = calendar.findIndex((c) => !c.unconfirmed && (c.end ?? c.start) >= today);

const day = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'Africa/Lagos' });
const month = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { month: 'short', timeZone: 'Africa/Lagos' });
const full = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Africa/Lagos',
  });

const visibleOutcomes = outcomes.slice(0, 8);
const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
---

<Base
  title="BIA JUPEB — JUPEB Admission Centre in Lagos | Direct Entry into 200 Level"
  description="Prepare for JUPEB with BIA JUPEB: an 8–9 month Science and Non-Science programme in Bariga, Lagos and online, with weekly tests, tutorials and Direct Entry admission guidance."
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">JUPEB admission centre · Bariga, Lagos &amp; online</p>
        <h1 id="hero-title" class="hero__title">
          Your direct route to <span class="hero__accent">200&nbsp;Level.</span>
        </h1>
        <p class="lead hero__lead">
          An {site.programmeLength.replace('months', 'month')} JUPEB programme for Science and Non-Science students — taught in person at our
          Bariga centre and online, with weekly tests, intensive tutorials and admission guidance.
        </p>
        <div class="hero__ctas">
          <a class="btn" href="#apply">Apply for {site.session}</a>
          <a class="btn btn--outline" href="#fees">See fees &amp; dates</a>
        </div>
      </div>

      <figure class="hero__figure">
        <Picture
          src={classroom}
          formats={formats}
          widths={[480, 800, 1080]}
          sizes="(min-width: 960px) 42vw, 100vw"
          alt="Students working at their desks during a BIA JUPEB class"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
        <figcaption>A BIA JUPEB class in session.</figcaption>
      </figure>
    </div>

    <div class="wrap">
      <dl class="facts">
        <div>
          <dt>Programme</dt>
          <dd>{site.programmeLength}</dd>
        </div>
        <div>
          <dt>Streams</dt>
          <dd>Science · Non-Science</dd>
        </div>
        <div>
          <dt>Study mode</dt>
          <dd>Physical &amp; online</dd>
        </div>
        <div>
          <dt>Registration fee</dt>
          <dd class="num">{naira(fees.registration)}<small>Non-refundable</small></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 01 OUTCOMES -->
  <section class="section" aria-labelledby="outcomes">
    <div class="wrap">
      <SectionHead index="01" eyebrow="Honours roll" title="Results our students have carried into university." id="outcomes">
        <p>
          A selection of JUPEB grades and the courses our alumni went on to study. Recorded by BIA JUPEB from past
          sessions.
        </p>
      </SectionHead>

      <ol class="roll">
        {visibleOutcomes.map((o) => (
          <li class="roll__item">
            <span class="roll__grade" aria-label={`Grades ${o.grade.split('').join(', ')}`}>{o.grade}</span>
            <span class="roll__detail">
              <span class="roll__course">{o.course}</span>
              <span class="roll__meta">
                {[o.institution, o.level].filter(Boolean).join(' · ')}
              </span>
            </span>
            <span class="roll__who">{o.consentVerified && o.name ? o.name : 'BIA JUPEB alumnus'}</span>
          </li>
        ))}
      </ol>
      <p class="roll__note">Student names and photographs are published only with verified consent.</p>
    </div>
  </section>

  <!-- 02 HOW JUPEB WORKS -->
  <section class="section section--tint" aria-labelledby="how">
    <div class="wrap">
      <SectionHead index="02" eyebrow="How JUPEB works" title="One focused year between O-Level and 200 Level." id="how">
        <p>
          JUPEB — the Joint Universities Preliminary Examinations Board — runs a one-year, A-Level standard programme
          recognised by Nigerian universities. Successful candidates use their results for Direct Entry admission into
          200 Level.
        </p>
      </SectionHead>

      <ol class="steps">
        <li>
          <span class="steps__n num">01</span>
          <h3>Register with BIA JUPEB</h3>
          <p>Secure your place for the session and choose a subject combination that matches your intended course.</p>
        </li>
        <li>
          <span class="steps__n num">02</span>
          <h3>Study for {site.programmeLength}</h3>
          <p>Online and physical lectures, weekly tests, intensive tutorials and continuous assessment.</p>
        </li>
        <li>
          <span class="steps__n num">03</span>
          <h3>Sit the JUPEB examinations</h3>
          <p>Your grades convert to points. The higher your points, the stronger your admission chances.</p>
        </li>
        <li>
          <span class="steps__n num">04</span>
          <h3>Apply for Direct Entry</h3>
          <p>We guide you through the Direct Entry window, timelines and documentation for 200 Level.</p>
        </li>
      </ol>

      <div class="scale" aria-labelledby="scale-title">
        <p id="scale-title" class="scale__title">JUPEB points scale</p>
        <ul class="scale__list">
          {gradePoints.map(([g, p]) => (
            <li><span class="scale__g">{g}</span><span class="scale__p num">{p}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 03 PROGRAMME & FEES -->
  <section class="section" id="programme" aria-labelledby="fees">
    <div class="wrap">
      <SectionHead index="03" eyebrow={`Programme & fees · ${site.session}`} title="Two streams. Clear, published fees." id="fees">
        <p>
          A {naira(fees.registration)} registration fee (non-refundable) applies to both streams. Fees can be paid in full
          or in instalments.
        </p>
      </SectionHead>

      <div class="fees">
        <div class="fees__table-wrap">
          <table class="fees__table">
            <caption class="sr-only">Programme fees for the {site.session} session</caption>
            <thead>
              <tr>
                <td></td>
                {fees.programmes.map((p) => (
                  <th scope="col">
                    <span class="fees__stream">{p.name}</span>
                    {p.sub && <span class="fees__sub">{p.sub}</span>}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">School fees</th>
                {fees.programmes.map((p) => <td class="num">{naira(p.school)}</td>)}
              </tr>
              <tr>
                <th scope="row">Tutorial fees</th>
                {fees.programmes.map((p) => <td class="num">{naira(p.tutorial)}</td>)}
              </tr>
              <tr class="fees__total">
                <th scope="row">Total</th>
                {fees.programmes.map((p) => <td class="num">{naira(p.total)}</td>)}
              </tr>
            </tbody>
          </table>
          <ul class="fees__blurbs">
            {fees.programmes.map((p) => <li><strong>{p.name}.</strong> {p.blurb}</li>)}
          </ul>
        </div>

        <aside class="plan" aria-labelledby="plan-title">
          <h3 id="plan-title" class="plan__title">Instalment plan</h3>
          <ol class="plan__list">
            {fees.plan.map((s, i) => (
              <li>
                <span class="plan__n num">{i + 1}</span>
                <span class="plan__amt num">{s.amount ? naira(s.amount) : s.label}</span>
                <span class="plan__label">{s.amount ? s.label : s.when}</span>
              </li>
            ))}
          </ol>
          <p class="plan__note">{fees.planNote}</p>
        </aside>
      </div>

      <div class="combos">
        <h3 class="combos__title">Popular subject combinations</h3>
        <dl class="combos__list">
          {combinations.map((c) => (
            <div>
              <dt>{c.course}</dt>
              <dd>{c.subjects.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 04 CALENDAR -->
  <section class="section section--ink" aria-labelledby="calendar">
    <div class="wrap">
      <SectionHead index="04" eyebrow="Academic calendar" title={`The ${site.session} session.`} id="calendar" tone="ink">
        <p>Key dates as published by BIA JUPEB.</p>
      </SectionHead>

      <ol class="timeline">
        {calendar.map((c, i) => {
          const state = c.unconfirmed ? 'tbc' : i === nextIndex ? 'next' : (c.end ?? c.start) < today ? 'past' : 'upcoming';
          return (
            <li class:list={['timeline__item', `is-${state}`]}>
              <span class="timeline__date">
                <span class="timeline__day num">{day(c.start)}</span>
                <span class="timeline__month">{month(c.start)}</span>
              </span>
              <span class="timeline__body">
                <span class="timeline__label">{c.label}</span>
                <span class="timeline__range">
                  {c.end ? `${full(c.start)} – ${full(c.end)}` : full(c.start)}
                </span>
                {state === 'next' && <span class="timeline__tag">Next</span>}
                {state === 'tbc' && <span class="timeline__tag timeline__tag--tbc">To be confirmed</span>}
              </span>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- 05 WAYS TO STUDY -->
  <section class="section" aria-labelledby="study">
    <div class="wrap">
      <SectionHead index="05" eyebrow="Ways to study" title="In the classroom or from anywhere in Nigeria." id="study" />

      <div class="modes">
        <article class="mode">
          <p class="mode__kicker">Physical</p>
          <h3>At our Bariga centre</h3>
          <p>Classroom lectures in Lagos, with tutors on hand to take you through each subject step by step.</p>
        </article>
        <article class="mode">
          <p class="mode__kicker">Online</p>
          <h3>Live and recorded lessons</h3>
          <p>Study from anywhere in Nigeria with live classes and recordings you can return to when revising.</p>
        </article>
        <div class="mode mode--shared">
          <p class="mode__kicker">Every student receives</p>
          <ul>
            <li>Weekly tests and intensive tutorials</li>
            <li>Continuous assessment and exam practice</li>
            <li>Past questions for registered students</li>
            <li>Admission guidance into university</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 LEADERSHIP -->
  <section class="section section--tint" aria-labelledby="people">
    <div class="wrap">
      <SectionHead index="06" eyebrow="Leadership & admissions" title="The people who will guide you." id="people" />

      <div class="people">
        <figure class="founder">
          <div class="founder__photos">
            <Picture
              src={founder}
              formats={formats}
              widths={[360, 640]}
              sizes="(min-width: 960px) 26vw, 60vw"
              alt="Dr. MedicBoma, founder of BIA JUPEB"
              class="founder__main"
            />
            <Picture
              src={founderTeaching}
              formats={formats}
              widths={[300, 520]}
              sizes="(min-width: 960px) 16vw, 36vw"
              alt="Dr. MedicBoma addressing students in class"
              class="founder__inset"
            />
          </div>
          <figcaption>
            <span class="founder__name">Dr. MedicBoma</span>
            <span class="founder__aka">Hon. Busari Muideen Oyebamiji</span>
            <span class="founder__role">
              Founder of Boma Academy Limited (BAL), Boma’s Intellectual Academy (BIA) and BIA JUPEB.
            </span>
          </figcaption>
        </figure>

        <div class="people__side">
          <blockquote class="mission">
            <p>
              “To help every student gain admission into their dream university through structured learning,
              discipline, and modern teaching methods.”
            </p>
            <footer>Our mission</footer>
          </blockquote>

          <div class="team">
            <h3 class="team__title">Admissions team</h3>
            <ul class="team__list">
              {contacts.map((c) => (
                <li>
                  <span>
                    <span class="team__name">{c.name ?? c.role}</span>
                    {c.name && <span class="team__role">{c.role}</span>}
                  </span>
                  <a class="team__tel num" href={`tel:${c.phone}`}>{c.display}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 FAQ -->
  <section class="section" aria-labelledby="faq">
    <div class="wrap faq">
      <SectionHead index="07" eyebrow="Questions" title="What applicants ask us most." id="faq" />
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 08 GUIDES -->
  <section class="section section--tint" aria-labelledby="guides">
    <div class="wrap">
      <SectionHead index="08" eyebrow="Guides" title="Read before you register." id="guides" />
      <ul class="guides">
        {guides.map((g, i) => (
          <li>
            <a href={g.href}>
              <span class="guides__n num">{String(i + 1).padStart(2, '0')}</span>
              <span class="guides__t">{g.title}</span>
              <span class="guides__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- APPLY / VISIT -->
  <section class="apply" id="apply" aria-labelledby="apply-title">
    <div class="wrap apply__grid">
      <div class="apply__copy">
        <p class="eyebrow apply__eyebrow">Apply · {site.session}</p>
        <h2 id="apply-title" class="apply__title">Start your application.</h2>
        <p class="apply__lead">
          Registration is handled by our admissions office. Call to begin your application, or visit the centre with
          your O-Level result (or evidence of an awaiting result) and a passport photograph.
        </p>
        <div class="apply__ctas">
          <a class="btn" href={`tel:${primaryContact.phone}`}>Call {primaryContact.display}</a>
          <a class="btn btn--on-ink" href={address.mapsUrl} rel="noopener" target="_blank">Get directions</a>
        </div>
      </div>

      <figure class="apply__visit">
        <Picture
          src={centre}
          formats={formats}
          widths={[480, 800, 1200]}
          sizes="(min-width: 960px) 40vw, 100vw"
          alt="Entrance gate of the BIA JUPEB centre in Bariga"
          class="apply__img"
        />
        <figcaption>
          <span class="apply__place">Bariga centre</span>
          <address>{address.lines.join(', ')}</address>
          <span class="apply__landmark">{address.landmark}</span>
        </figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  /* Sections */
  .section {
    padding-block: var(--section);
  }
  .section--tint {
    background: var(--paper-2);
  }
  .section--ink {
    background: var(--ink);
    color: var(--on-ink);
  }

  /* Hero */
  .hero {
    padding-block: var(--s-6) 0;
  }
  .hero__grid {
    display: grid;
    gap: var(--s-7);
    align-items: end;
  }
  .hero__copy {
    display: grid;
    gap: var(--s-5);
  }
  .hero__title {
    font-size: var(--step-4);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 11ch;
  }
  .hero__accent {
    color: var(--crimson);
    font-style: italic;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .hero__figure {
    margin: 0;
  }
  .hero__figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .hero__figure figcaption,
  .founder figcaption,
  .apply__visit figcaption {
    margin-top: var(--s-2);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: var(--s-8) 0 0;
    border-top: 1px solid var(--ink);
  }
  .facts > div {
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .facts > div:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .facts > div:nth-child(even) {
    padding-left: var(--s-4);
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: var(--s-1) 0 0;
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .facts small {
    display: block;
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 2px;
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: var(--s-8) 0;
    }
    .hero__grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-8);
    }
    .hero__figure :global(img) {
      aspect-ratio: 4 / 5;
    }
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
    .facts > div,
    .facts > div:nth-child(even) {
      padding: var(--s-5) var(--s-5);
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .facts > div:first-child {
      padding-left: 0;
    }
    .facts > div:last-child {
      border-right: 0;
    }
  }

  /* Honours roll */
  .roll {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--ink);
  }
  .roll__item {
    display: grid;
    grid-template-columns: 4.6rem 1fr;
    gap: var(--s-1) var(--s-4);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .roll__grade {
    grid-row: span 2;
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--brass);
  }
  .roll__detail {
    display: grid;
  }
  .roll__course {
    font-weight: 600;
    line-height: 1.3;
  }
  .roll__meta {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .roll__who {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
    font-family: var(--serif);
  }
  .roll__note {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (min-width: 840px) {
    .roll {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s-7);
    }
    .roll__grade {
      font-size: var(--step-3);
    }
    .roll__item {
      grid-template-columns: 6rem 1fr;
    }
  }

  /* Steps */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-6);
    counter-reset: step;
  }
  .steps li {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
  }
  .steps__n {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--crimson);
  }
  .steps h3 {
    font-size: var(--step-1);
  }
  .steps p {
    color: var(--ink-2);
    max-width: 34ch;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .scale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .scale__title {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .scale__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .scale__list li {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .scale__g {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1;
  }
  .scale__p {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .scale__p::after {
    content: ' pts';
  }

  /* Fees */
  .fees {
    display: grid;
    gap: var(--s-7);
  }
  .fees__table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .fees__table th,
  .fees__table td {
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    text-align: right;
    vertical-align: bottom;
  }
  .fees__table th[scope='row'] {
    text-align: left;
    font-weight: 500;
    color: var(--ink-2);
  }
  .fees__table thead th {
    border-bottom: 1px solid var(--ink);
    padding-top: 0;
  }
  .fees__table thead td {
    border-bottom: 1px solid var(--ink);
  }
  .fees__stream {
    display: block;
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 450;
  }
  .fees__sub {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }
  .fees__table td {
    padding-left: var(--s-4);
    font-size: var(--step-0);
  }
  .fees__total th,
  .fees__total td {
    border-bottom: 0;
    padding-top: var(--s-5);
