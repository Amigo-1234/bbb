    .scale__bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .scale__p {
      text-align: left;
    }
  }

  /* ---------- Fees ---------- */
  .path-badge {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--crimson);
    color: #fff;
    font-family: var(--serif);
    font-size: 1.1rem;
  }
  .path-title {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
    font-size: var(--step-2);
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }
  .fees-more {
    margin-top: var(--s-6);
  }
  .tutorials {
    margin-top: var(--s-8);
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }
  .fees-foot {
    display: grid;
    gap: var(--s-7);
    margin-top: var(--s-7);
  }
  .combos__title {
    font-size: var(--step-2);
    margin-bottom: var(--s-4);
  }
  .combos__list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .combos__list > div {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .combos__list dt {
    font-weight: 800;
  }
  .combos__list dd {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
  }
  .combos__chip {
    padding: 0.25em 0.7em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--step--1);
    font-weight: 600;
  }
  @media (min-width: 960px) {
    .fees-foot {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-8);
    }
  }

  /* ---------- Timeline ---------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .timeline__date {
    display: grid;
    line-height: 1;
  }
  .timeline__day {
    font-family: var(--serif);
    font-size: var(--step-3);
  }
  .timeline__month {
    margin-top: var(--s-1);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .timeline__body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
  }
  .timeline__label {
    flex-basis: 100%;
    font-family: var(--serif);
    font-size: var(--step-1);
  }
  .timeline__range {
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .timeline__tag {
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--crimson);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .timeline__tag--tbc {
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.35);
    color: var(--on-ink-muted);
  }
  .is-past .timeline__day,
  .is-past .timeline__label {
    color: var(--on-ink-muted);
  }
  .is-next .timeline__day {
    color: #f0b7bf;
  }
  @media (min-width: 960px) {
    .timeline {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--s-5);
    }
    .timeline__item {
      grid-template-columns: 1fr;
      align-content: start;
      border-top-width: 2px;
    }
    .is-next {
      border-top-color: var(--crimson);
    }
  }

  /* ---------- Modes ---------- */
  .modes {
    display: grid;
    gap: var(--s-6);
  }
  .mode {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 2px solid var(--ink);
  }
  .mode__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: var(--crimson-wash);
    color: var(--crimson);
  }
  .mode h3 {
    font-size: var(--step-2);
  }
  .mode p:not(.mode__kicker) {
    color: var(--ink-2);
    max-width: 36ch;
  }
  .mode__kicker {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  .mode--ext {
    border-top-color: var(--bia-red);
  }
  .mode--ext .mode__icon {
    background: var(--bia-red);
    color: #fff;
  }
  @media (min-width: 840px) {
    .modes {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-6);
    }
  }

  /* ---------- Week preview ---------- */
  .week {
    margin-top: var(--s-8);
    padding: var(--s-5);
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--radius);
  }
  .week__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .week__head .link-arrow {
    color: #ffb3b3;
  }
  .week__title {
    font-size: var(--step-2);
    color: #fff;
  }
  .week__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
  .week__list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 2px var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .week__day abbr {
    font-family: var(--serif);
    font-size: var(--step-1);
    text-decoration: none;
    color: #fff;
  }
  .week__span {
    font-size: var(--step--1);
    font-weight: 800;
    color: #ffb3b3;
  }
  .week__items {
    grid-column: 2;
    color: var(--on-ink);
    font-size: var(--step--1);
  }
  .week__note {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  @media (min-width: 840px) {
    .week {
      padding: var(--s-6) var(--s-7);
    }
    .week__list li {
      grid-template-columns: 4rem 11rem 1fr;
      align-items: baseline;
    }
    .week__items {
      grid-column: auto;
    }
  }

  /* ---------- Gallery ---------- */
  .shot figure {
    margin: 0;
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .shot figcaption {
    margin-top: var(--s-3);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }

  /* ---------- People ---------- */
  .people {
    display: grid;
    gap: var(--s-8);
  }
  .founder {
    position: relative;
    margin: 0;
  }
  .founder :global(.founder__seal) {
    position: absolute;
    right: calc(-1 * var(--s-3));
    top: calc(-1 * var(--s-5));
    width: 112px;
    height: auto;
    filter: drop-shadow(0 10px 20px rgb(21 23 30 / 0.3));
  }
  .fsec .people {
    position: relative;
    isolation: isolate;
  }
  .moment {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--s-4);
    align-items: center;
    margin: 0;
    padding: var(--s-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .moment :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
  }
  .moment figcaption {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .founder :global(picture) {
    display: block;
    margin: 0 var(--s-4) var(--s-4) 0;
    box-shadow: var(--s-4) var(--s-4) 0 var(--bia-red);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .founder :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
  }
  .founder figcaption {
    display: grid;
    gap: 2px;
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .founder__name {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--ink);
  }
  .founder__aka {
    font-weight: 700;
    color: var(--ink-2);
  }
  .founder__role {
    max-width: 40ch;
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--ink);
  }
  .people__side {
    display: grid;
    gap: var(--s-7);
    align-content: start;
  }
  .mission {
    margin: 0;
  }
  .mission {
    padding-left: var(--s-5);
    border-left: 4px solid var(--bia-red);
  }
  .mission__mark {
    width: 40px;
    fill: var(--bia-red);
    margin-bottom: var(--s-4);
  }
  .mission p {
    font-family: var(--serif);
    font-size: var(--step-3);
    font-weight: 380;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .mission footer {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .team__title {
    font-size: var(--step-1);
    margin-bottom: var(--s-3);
  }
  .team__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .team__list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .team__list li > span {
    display: grid;
  }
  .team__name {
    font-weight: 700;
  }
  .team__role {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .team__tel {
    flex: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    color: var(--crimson);
    text-decoration: none;
  }
  .team__tel:hover {
    text-decoration: underline;
  }
  @media (min-width: 960px) {
    .people {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-9);
    }
  }

  /* ---------- FAQ ---------- */
  .faq__list {
    border-top: 1px solid var(--ink);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    min-height: 64px;
    padding: var(--s-4) 0;
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary:hover {
    color: var(--crimson);
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
    transition: transform 0.2s var(--ease);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__item p {
    padding-bottom: var(--s-5);
    max-width: 64ch;
    color: var(--ink-2);
  }
  @media (min-width: 960px) {
    .faq {
      display: grid;
      grid-template-columns: 4fr 8fr;
      column-gap: var(--s-6);
    }
    .faq :global(.head) {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
      align-content: start;
      grid-template-columns: 1fr;
      border-top: 0;
      padding-top: 0;
    }
    .faq :global(.head__label) {
      grid-row: auto;
    }
  }

  /* ---------- Guides ---------- */
  .guides {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .guides a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
  }
  .guides__n {
    font-size: var(--step--1);
    font-weight: 800;
    color: var(--crimson);
  }
  .guides__t {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .guides a :global(.guides__arrow) {
    align-self: center;
    color: var(--muted);
    transition: transform 0.18s var(--ease), color 0.18s var(--ease);
  }
  .guides a:hover .guides__t,
  .guides a:hover :global(.guides__arrow) {
    color: var(--crimson);
  }
  .guides a:hover :global(.guides__arrow) {
    transform: translate(3px, -3px);
  }

  /* ---------- Apply ---------- */
  .apply {
    position: relative;
    overflow: hidden;
    background: var(--bia-red);
    color: var(--on-red);
    padding-block: var(--section);
  }
  .apply :global(.apply__watermark) {
    position: absolute;
    left: -140px;
    bottom: -120px;
    width: 560px;
    height: auto;
    color: #fff;
    opacity: 0.08;
    pointer-events: none;
  }
  .apply__grid {
    position: relative;
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }
  .apply__copy {
    display: grid;
    gap: var(--s-5);
  }
  .apply__eyebrow {
    color: var(--on-red-muted);
  }
  .apply__title {
    font-size: var(--step-5);
    font-weight: 380;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .apply__title em {
    color: #fff;
  }
  .apply__lead {
    max-width: 46ch;
    color: var(--on-red-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .apply__ctas .btn {
    white-space: normal;
  }
  .apply__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .apply__card {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    padding: var(--s-6);
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--radius);
  }
  .apply__card address {
    display: grid;
    font-style: normal;
    color: var(--on-ink-muted);
  }
  .apply__place {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: #fff;
  }
  .apply__tels {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .apply__tels a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--serif);
    font-size: var(--step-2);
    color: #fff;
    text-decoration: none;
  }
  @media (min-width: 960px) {
    .apply__grid {
      grid-template-columns: 7fr 4fr;
      gap: var(--s-9);
    }
  }

  /* ---------- About BIA (red) ---------- */
  .about {
    position: relative;
    overflow: hidden;
    padding-block: var(--section);
    background: var(--bia-red);
    color: var(--on-red);
  }
  .about :global(.about__watermark) {
    position: absolute;
    right: -160px;
    top: -60px;
    width: 620px;
    height: auto;
    color: #fff;
    opacity: 0.07;
    pointer-events: none;
  }
  .about__grid {
    position: relative;
    display: grid;
    gap: var(--s-8);
  }
  .about__intro {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .about__label {
    display: flex;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.45);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-red-muted);
  }
  .about__title {
    font-size: var(--step-4);
    font-weight: 380;
    line-height: 1;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .about__title em {
    display: block;
  }
  .about__lead {
    max-width: 48ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--on-red-muted);
  }
  .about__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .about__side {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }
  .about__block {
    padding: var(--s-5);
    background: rgb(0 0 0 / 0.16);
    border-radius: var(--radius);
  }
  .about__h {
    margin-bottom: var(--s-3);
    font-size: var(--step-1);
    color: #fff;
  }
  .about__offers {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about__offers li {
    display: flex;
    gap: var(--s-2);
  }
  .about__offers :global(svg) {
    flex: none;
    margin-top: 0.2em;
  }
  .about__who {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about__who li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
  }
  .about__who strong {
    display: block;
    color: #fff;
  }
  .about__who li > span:last-child {
    color: var(--on-red-muted);
  }
  .about__n {
    font-weight: 800;
    color: #fff;
  }
  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: 6fr 5fr;
      gap: var(--s-9);
    }
  }

  /* ---------- Requirements & documents ---------- */
  .reqdocs {
    display: grid;
    gap: var(--s-7);
    margin-top: var(--s-7);
    padding-top: var(--s-7);
    border-top: 1px solid var(--line-strong);
  }
  .req__title {
    margin-bottom: var(--s-4);
    font-size: var(--step-2);
  }
  .req__list {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .req__list li {
    display: flex;
    gap: var(--s-2);
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .req__list :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--bia-red);
  }
  .req__note {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  @media (min-width: 960px) {
    .reqdocs {
      grid-template-columns: 4fr 7fr;
      gap: var(--s-8);
    }
  }

  /* ---------- Location ---------- */
  .loc {
    background: var(--ink);
    color: var(--on-ink);
  }
  .loc__grid {
    display: grid;
    gap: var(--s-7);
  }
  .loc__info {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }
  .loc__address {
    display: grid;
    gap: 2px;
    font-style: normal;
  }
  .loc__name {
    margin-bottom: var(--s-2);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffb3b3;
  }
  .loc__line {
    font-family: var(--serif);
    font-size: var(--step-3);
    line-height: 1.1;
    color: #fff;
  }
  .loc__landmark {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-3);
    color: var(--on-ink-muted);
  }
  .loc__landmark :global(svg) {
    flex: none;
    margin-top: 0.25em;
    color: #ff8080;
  }
  .loc__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .loc__ctas .btn {
    white-space: normal;
  }
  .routes {
    display: grid;
    gap: var(--s-4);
