---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import ProgrammeFees from '../components/ProgrammeFees.astro';
import InstalmentPlan from '../components/InstalmentPlan.astro';
import TutorialPackage from '../components/TutorialPackage.astro';
import FeePaths from '../components/FeePaths.astro';
import Laurel from '../components/Laurel.astro';
import Badge from '../components/Badge.astro';
import OfficialDocs from '../components/OfficialDocs.astro';
import { getImage } from 'astro:assets';
import { audiences, directions, directionsCaptions, founder as founderInfo, mission, offers, routeCaption } from '../data/identity';
import { docs } from '../data/documents';
import { tutorialPackage } from '../data/fees';
import { firstSemester } from '../data/timetable';
import poster from '../assets/official/directions-poster.jpg';
import {
  admissionsByInstitution,
  address,
  calendar,
  combinations,
  contacts,
  faqs,
  registration,
  gradePoints,
  guides,
  naira,
  outcomes,
  primaryContact,
  site,
  whatsapp,
} from '../data/site';
import classroom from '../assets/photos/classroom.png';
import class010 from '../assets/photos/class-010.png';
import class011 from '../assets/photos/class-011.png';
import class012 from '../assets/photos/class-012.png';
import class013 from '../assets/photos/class-013.png';
import class014 from '../assets/photos/class-014.png';
import class015 from '../assets/photos/class-015.png';
import class016 from '../assets/photos/class-016.png';
import founder from '../assets/photos/founder.png';
import founderTeaching from '../assets/photos/founder-teaching.jpg';
import centre from '../assets/photos/centre-entrance.jpg';

type Photo = { src: ImageMetadata; alt: string; caption: string; position?: string };

// Authentic photographs from the legacy site (assets/images/slider, boma5, teachers).
const heroPhotos: Photo[] = [
  { src: classroom, alt: 'A full classroom of BIA JUPEB students working at their desks', caption: 'A full class in session' },
  { src: class010, alt: 'Students seated in rows in a lecture hall, writing', caption: 'Lecture hall session' },
  { src: class016, alt: 'A tutor standing beside students as they work', caption: 'Tutor-led classwork', position: 'center 35%' },
  { src: class012, alt: 'A tutor moving between desks in a busy classroom', caption: 'Guidance at every desk' },
];

const gallery: Photo[] = [
  { src: class013, alt: 'Students concentrating on written work', caption: 'Focused classwork' },
  { src: class011, alt: 'Students seated at long desks during class', caption: 'Students in class' },
  { src: class015, alt: 'A student at a lectern in front of a whiteboard', caption: 'At the front of the class' },
  { src: class014, alt: 'Students writing while a tutor looks on', caption: 'Classwork with tutor support' },
];

const today = new Date().toISOString().slice(0, 10);
const nextIndex = calendar.findIndex((c) => !c.unconfirmed && (c.end ?? c.start) >= today);
const tz = { timeZone: 'Africa/Lagos' } as const;
const d = (s: string) => new Date(s + 'T12:00:00Z');
const day = (s: string) => d(s).toLocaleDateString('en-GB', { day: 'numeric', ...tz });
const month = (s: string) => d(s).toLocaleDateString('en-GB', { month: 'short', ...tz });
const full = (s: string) => d(s).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', ...tz });

const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
const posterImg = await getImage({ src: poster, format: 'webp', width: 464 });
const fmtCap = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
// "This week" preview, straight from the official first-semester timetable.
const week = firstSemester.days.map((d) => ({
  day: d.day,
  name: d.name,
  items: d.sessions.map((x) => x.title ?? x.subjects?.join(' · ') ?? ''),
  span: (() => {
    const t = d.sessions.filter((x) => x.time);
    return t.length ? `${t[0].time!.split('–')[0].trim()} – ${t[t.length - 1].time!.split('–')[1].trim()}` : '';
  })(),
}));
---

<Base
  motion
  title="BIA JUPEB — JUPEB Admission Centre in Lagos | Direct Entry into 200 Level"
  description="Prepare for JUPEB with BIA JUPEB: Boma’s Intellectual Academy’s 8–9 month Science and Non-Science programme in Akoka, Lagos and online, with weekly tests, tutorials and Direct Entry admission guidance."
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow with-icon"><Icon name="pin" size={16} />Boma’s Intellectual Academy · Akoka, Lagos &amp; online</p>
        <h1 id="hero-title" class="hero__title">
          Your direct route to <em>200&nbsp;Level.</em>
        </h1>
        <p class="lead hero__lead">
          An {site.programmeLength.replace('months', 'month')} JUPEB programme for Science and Non-Science students —
          taught in person in Lagos and online, with weekly tests, intensive tutorials and admission
          guidance.
        </p>
        <div class="hero__ctas" data-cta-zone>
          <a class="btn" href="#apply" data-cta="home-hero-enquire">Enquire about JUPEB admission<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--outline" href="#programme">Explore programmes</a>
        </div>
        <a class="hero__call" href={`tel:${primaryContact.phone}`} data-cta="home-hero-call">
          <span class="hero__call-icon"><Icon name="phone" size={18} /></span>
          <span>
            <span class="hero__call-label">Speak to admissions</span>
            <span class="hero__call-num num">{primaryContact.display}</span>
          </span>
        </a>
      </div>

      <div class="hero__media">
        <Carousel label="Classes at BIA JUPEB" variant="hero" autoplay>
          {heroPhotos.map((p, i) => (
            <div data-slide class="hero__slide">
              <figure>
                <Picture
                  src={p.src}
                  formats={formats}
                  widths={[480, 800, 1080, 1280]}
                  sizes="(min-width: 960px) 58vw, 100vw"
                  alt={p.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  style={p.position ? `object-position:${p.position}` : undefined}
                />
                <figcaption>{p.caption}</figcaption>
              </figure>
            </div>
          ))}
        </Carousel>
        <div class="hero__inset hero__seal">
          <Badge variant="seal" size={150} label="Official badge of Boma’s Intellectual Academy (BIA)" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        <div>
          <dt>Programme</dt>
          <dd>{site.programmeLength}</dd>
        </div>
        <div>
          <dt>Streams</dt>
          <dd>Science · Non‑Science</dd>
        </div>
        <div>
          <dt>Study mode</dt>
          <dd>Physical &amp; online</dd>
        </div>
        <div>
          <dt>Registration fee</dt>
          <dd class="num">{naira(registration.amount)}<small>Non-refundable</small></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 01 ABOUT BIA -->
  <section class="about" id="about" aria-labelledby="about-title">
    <Badge variant="mark" size={620} class="about__watermark" />
    <div class="wrap about__grid">
      <div class="about__intro">
        <p class="about__label"><span class="num">01</span><span>About BIA</span></p>
        <h2 id="about-title" class="about__title">This is BIA — <em>Boma’s Intellectual Academy.</em></h2>
        <p class="about__lead">
          BIA JUPEB is the JUPEB programme of Boma’s Intellectual Academy — {site.descriptor}. We prepare Science and
          Non-Science students for the JUPEB examinations and Direct Entry into 200 Level, in class in Lagos and online.
        </p>
        <div class="about__ctas">
          <a class="btn btn--white" href="#programme" data-cta="home-about-programme">Programme &amp; fees<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--on-red" href="#founder" data-cta="home-about-founder">Meet the founder</a>
        </div>
      </div>
      <div class="about__side">
        <div class="about__block">
          <h3 class="about__h">What BIA offers</h3>
          <ul class="about__offers">
            {offers.map((o) => <li><Icon name="check" size={18} />{o}</li>)}
          </ul>
        </div>
        <div class="about__block">
          <h3 class="about__h">Who it is for</h3>
          <ol class="about__who">
            {audiences.map((a, i) => (
              <li>
                <span class="about__n num">{String(i + 1).padStart(2, '0')}</span>
                <span><strong>{a.title}</strong>{a.text}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 STUDENT SUCCESS -->
  <section class="section section--ink honours" id="success" aria-labelledby="outcomes">
    <svg class="honours__mark" viewBox="0 0 400 400" aria-hidden="true" data-clip>
      <text x="200" y="330" text-anchor="middle">A</text>
    </svg>
    <div class="wrap">
      <SectionHead index="02" eyebrow="Student success" title="Results our students have carried into university." id="outcomes" tone="ink">
        <p>JUPEB grades and university places achieved by BIA JUPEB students, as recorded by BIA JUPEB.</p>
      </SectionHead>

      <div class="honours__grid">
        <aside class="congrats" aria-labelledby="congrats-title">
          <Laurel class="congrats__laurel" size={120} />
          <p class="congrats__kicker">With pride, from all of us at BIA JUPEB</p>
          <h3 id="congrats-title" class="congrats__title">Congratulations</h3>
          <p class="congrats__text">to every student who turned months of focused work into a university place.</p>
          <div class="congrats__unis">
            <p class="congrats__label">Admissions recorded at</p>
            <ul>{admissionsByInstitution.map((a) => <li>{a.institution}</li>)}</ul>
          </div>
          <div class="congrats__ctas">
            <a class="btn" href="/success-stories" data-cta="home-success-stories">Read success stories<Icon name="arrow-right" size={18} /></a>
            <a class="btn btn--on-ink" href="#apply" data-cta="home-success-enquire">Enquire about admission</a>
          </div>
        </aside>

        <div class="honours__slider">
          <Carousel label="Student results" variant="pair" tone="ink">
            {outcomes.filter((o) => o.grade).slice(0, 10).map((o) => (
              <div data-slide class="result">
                <p class="result__top">
                  <span>Congratulations</span>
                  {o.level && <span class="result__level">{o.level}</span>}
                </p>
                <p class="result__grade"><span class="sr-only">Grades {o.grade.split('').join(', ')}</span>{o.grade.split('').map((g) => <span aria-hidden="true">{g}</span>)}</p>
                <p class="result__course">{o.course}</p>
                <p class="result__inst">{o.institution ?? (o.consentVerified && o.name ? o.name : 'BIA JUPEB alumnus')}</p>
              </div>
            ))}
          </Carousel>
        </div>
      </div>
      <p class="honours__note">Names, photographs and testimonials are published only with each student’s written consent.</p>
    </div>
  </section>

  <!-- 03 HOW JUPEB WORKS -->
  <section class="section" aria-labelledby="how">
    <div class="wrap">
      <SectionHead index="03" eyebrow="How JUPEB works" title="One focused year between O-Level and 200 Level." id="how">
        <p>
          JUPEB — the Joint Universities Preliminary Examinations Board — runs a one-year, A-Level standard programme
          recognised by Nigerian universities. Successful candidates use their results for Direct Entry admission into
          200 Level.
        </p>
      </SectionHead>

      <div class="journey">
      <div class="route__rail" aria-hidden="true"><span class="route__fill"></span></div>
      <ol class="route">
        <li>
          <span class="route__n num">01</span>
          <h3>Register with BIA JUPEB</h3>
          <p>Secure your place for the session and choose a subject combination that matches your intended course.</p>
        </li>
        <li>
          <span class="route__n num">02</span>
          <h3>Study for {site.programmeLength}</h3>
          <p>Online and physical lectures, weekly tests, intensive tutorials and continuous assessment.</p>
        </li>
        <li>
          <span class="route__n num">03</span>
          <h3>Sit the JUPEB examinations</h3>
          <p>Your grades convert to points. The higher your points, the stronger your admission chances.</p>
        </li>
        <li class="route__end">
          <span class="route__n num">04</span>
          <h3>Apply for Direct Entry</h3>
          <p>We guide you through the Direct Entry window, timelines and documentation for 200 Level.</p>
          <span class="route__dest">Destination · 200 Level</span>
        </li>
      </ol>
      </div>

      <div class="scale">
        <p class="scale__title">JUPEB points scale</p>
        <ul class="scale__list">
          {gradePoints.map(([g, p]) => (
            <li>
              <span class="scale__g">{g}</span>
              <span class="scale__bar" style={`--w:${p * 20}%`} aria-hidden="true"></span>
              <span class="scale__p num">{p} {p === 1 ? 'point' : 'points'}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 04 PROGRAMME & FEES -->
  <section class="section section--tint" id="programme" aria-labelledby="fees">
    <div class="wrap">
      <SectionHead index="04" eyebrow={`Programme & fees · ${site.session}`} title="Two ways to study with BIA. Clear, published fees." id="fees">
        <p>
          Join the full JUPEB admission programme, or take our physical tutorials only. Fees below are from BIA JUPEB’s
          official 2026/27 payment advice. All payments are non-refundable.
        </p>
      </SectionHead>

      <FeePaths base="" cta="home" />

      <h3 class="path-title" id="programme-fees"><span class="path-badge">A</span>Full JUPEB admission programme</h3>
      <ProgrammeFees level={4} />

      <div class="fees-foot">
        <InstalmentPlan />

        <div class="combos">
          <h3 class="combos__title">Popular subject combinations</h3>
          <dl class="combos__list">
            {combinations.map((c) => (
              <div>
                <dt>{c.course}</dt>
                <dd>
                  {c.subjects.map((s) => <span class="combos__chip">{s}</span>)}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
      <div class="reqdocs">
        <div class="req">
          <h3 class="req__title">To register you need</h3>
          <ul class="req__list">
            {registration.requirements.map((r) => <li><Icon name="check" size={18} />{r}</li>)}
          </ul>
          <p class="req__note">All payments are final and non-refundable. Registration and payment are handled by the admissions office — not online.</p>
        </div>
        <div class="reqdocs__docs">
          <h3 class="req__title">Official documents</h3>
          <OfficialDocs docs={[docs.scienceFees, docs.nonScienceFees, docs.paymentPlan, docs.entranceExam]} label="Official BIA fee documents" size="sm" />
        </div>
      </div>

      <p class="fees-more">
        <a class="link-arrow" href="/fees" data-cta="home-fees-details">Requirements, payment terms &amp; full fee details<Icon name="arrow-right" size={16} /></a>
      </p>

      <div class="tutorials" id="tutorials">
        <TutorialPackage />
      </div>
    </div>
  </section>

  <!-- 05 WAYS TO STUDY & TIMETABLE -->
  <section class="section" id="study-modes" aria-labelledby="study">
    <div class="wrap">
      <SectionHead index="05" eyebrow="Ways to study · Timetable" title="In class, online — or tutorials only." id="study">
        <p>Choose how you learn. Every route follows BIA’s official {site.session} timetable.</p>
      </SectionHead>

      <div class="modes">
        <article class="mode">
          <span class="mode__icon"><Icon name="building" size={26} /></span>
          <p class="mode__kicker">Physical classes</p>
          <h3>Lectures, tests and private classes in Lagos</h3>
          <p>Weekday lectures, Saturday tests and evening Special Private Classes. Self-study days run inside the MTN Library, UNILAG.</p>
        </article>
        <article class="mode">
          <span class="mode__icon"><Icon name="monitor" size={26} /></span>
          <p class="mode__kicker">Online · Lecture Banks</p>
          <h3>Recorded and live lessons</h3>
          <p>For students who cannot attend physical classes. Free online tutorials began on Monday 5 October 2026.</p>
        </article>
        <article class="mode mode--ext">
          <span class="mode__icon"><Icon name="arrow-up-right" size={26} /></span>
          <p class="mode__kicker">Tutorials only</p>
          <h3>For students from other institutions</h3>
          <p>Join BIA’s physical tutorials for {naira(tutorialPackage.oneTime.amount)} until the exam, or {naira(tutorialPackage.monthly.amount)} a month.</p>
        </article>
      </div>

      <div class="week" aria-labelledby="week-title">
        <div class="week__head">
          <h3 id="week-title" class="week__title">A week at BIA · first semester</h3>
          <a class="link-arrow" href="/timetable" data-cta="home-week-timetable">Full timetable, day by day<Icon name="arrow-right" size={16} /></a>
        </div>
        <ol class="week__list">
          {week.map((w) => (
            <li data-day={w.day}>
              <span class="week__day"><abbr title={w.name}>{w.day}</abbr></span>
              <span class="week__span num">{w.span}</span>
              <span class="week__items">{w.items.join(' · ')}</span>
            </li>
          ))}
        </ol>
        <p class="week__note">Every third week: night classes before the Monthly Mock Examination, held at the end of every fourth week.</p>
      </div>
    </div>
  </section>

  <!-- 06 CALENDAR -->
  <section class="section section--ink" aria-labelledby="calendar">
    <div class="wrap">
      <SectionHead index="06" eyebrow="Academic calendar" title={`The ${site.session} session.`} id="calendar" tone="ink">
        <p>Key dates as published by BIA JUPEB.</p>
      </SectionHead>

      <ol class="timeline">
        {calendar.map((c, i) => {
          const state = c.unconfirmed ? 'tbc' : i === nextIndex ? 'next' : (c.end ?? c.start) < today ? 'past' : 'upcoming';
          return (
            <li class:list={['timeline__item', `is-${state}`]}>
              <span class="timeline__date">
                <span class="timeline__day num">{day(c.start)}</span>
                <span class="timeline__month">{month(c.start)}</span>
              </span>
              <span class="timeline__body">
                <span class="timeline__label">{c.label}</span>
                <span class="timeline__range">{c.end ? `${full(c.start)} – ${full(c.end)}` : full(c.start)}</span>
                {state === 'next' && <span class="timeline__tag">Next</span>}
                {state === 'tbc' && <span class="timeline__tag timeline__tag--tbc">To be confirmed</span>}
              </span>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- 07 GALLERY -->
  <section class="section section--tint gallery" aria-labelledby="inside">
    <div class="wrap">
      <SectionHead index="07" eyebrow="Inside BIA JUPEB" title="Real classes. Real tutors. Real work." id="inside">
        <p>Photographs from our classes and tutorials.</p>
      </SectionHead>
      <Carousel label="Photographs from BIA JUPEB classes" variant="strip">
        {gallery.map((p) => (
          <div data-slide class="shot">
            <figure>
              <Picture
                src={p.src}
                formats={formats}
                widths={[480, 800, 1080]}
                sizes="(min-width: 1040px) 42vw, (min-width: 720px) 58vw, 86vw"
                alt={p.alt}
                style={p.position ? `object-position:${p.position}` : undefined}
              />
              <figcaption>{p.caption}</figcaption>
            </figure>
          </div>
        ))}
      </Carousel>
    </div>
  </section>

  <!-- 08 FOUNDER -->
  <section class="section fsec" id="founder" aria-labelledby="people">
    <div class="wrap">
      <SectionHead index="08" eyebrow="Founder & leadership" title="Boma’s Intellectual Academy, led by its founder." id="people" />

      <div class="people">
        <figure class="founder" data-clip>
          <Picture
            src={founder}
            formats={formats}
            widths={[360, 640]}
            sizes="(min-width: 960px) 34vw, 90vw"
            alt={`${founderInfo.name}, founder of Boma’s Intellectual Academy`}
          />
          <Badge variant="seal" size={112} class="founder__seal" />
          <figcaption>
            <span class="founder__name">{founderInfo.name}</span>
            <span class="founder__aka">{founderInfo.fullName}</span>
          </figcaption>
        </figure>

        <div class="people__side">
          <p class="founder__role">{founderInfo.role}.</p>
          <blockquote class="mission">
            <svg class="mission__mark" viewBox="0 0 48 36" aria-hidden="true">
              <path d="M0 36V20C0 8 7 1 19 0v7c-6 1-10 5-10 12h10v17Zm29 0V20C29 8 36 1 48 0v7c-6 1-10 5-10 12h10v17Z" />
            </svg>
            <p>{mission}</p>
            <footer>BIA’s mission</footer>
          </blockquote>

          <figure class="moment">
            <Picture
              src={founderTeaching}
              formats={formats}
              widths={[320, 560]}
              sizes="(min-width: 960px) 18vw, 40vw"
              alt="Dr. MedicBoma speaking to students with a microphone"
              style="object-position:center 25%"
            />
            <figcaption>
              <strong>Hands-on leadership.</strong> Boma speaks to students in person, and his line —
              {primaryContact.display} — is the admissions number on every official BIA document.
            </figcaption>
          </figure>

          <div class="team">
            <h3 class="team__title">Speak to admissions</h3>
            <ul class="team__list">
              {contacts.map((c) => (
                <li>
                  <span>
                    <span class="team__name">{c.name ?? c.role}</span>
                    {c.name && <span class="team__role">{c.role}</span>}
                  </span>
                  <a class="team__tel num" href={`tel:${c.phone}`} data-cta={`home-founder-call-${c.phone.slice(-4)}`}><Icon name="phone" size={16} />{c.display}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 LOCATION -->
  <section class="section loc" id="location" aria-labelledby="location-title">
    <div class="wrap">
      <SectionHead index="09" eyebrow="Location & directions" title="Find us at 12 Ameen Street, Akoka." id="location-title" tone="ink">
        <p>Our tutorial centre is a short walk from the University of Lagos. Watch BIA’s own directions video, or follow the written steps.</p>
      </SectionHead>

      <div class="loc__grid">
        <div class="loc__info">
          <address class="loc__address">
            <span class="loc__name">{address.name}</span>
            {address.lines.map((l) => <span class="loc__line">{l}</span>)}
            <span class="loc__landmark"><Icon name="pin" size={16} />Landmark: {address.landmark}</span>
          </address>
          <div class="loc__ctas" data-cta-zone>
            {contacts.map((c) => (
              <a class="btn" href={`tel:${c.phone}`} data-cta={`home-location-call-${c.phone.slice(-4)}`}><Icon name="phone" size={18} />Call {c.display}</a>
            ))}
            <a class="btn btn--on-ink" href={whatsapp} rel="noopener" target="_blank" data-cta="home-location-whatsapp">WhatsApp admissions</a>
            <a class="btn btn--on-ink" href={address.mapsUrl} rel="noopener" target="_blank" data-cta="home-location-map"><Icon name="pin" size={18} />Open in Google Maps</a>
          </div>

          <div class="routes">
            <div class="route-card">
              <h3>From the University of Lagos</h3>
              <ol>{directions.fromUnilag.map((t) => <li>{t}</li>)}</ol>
            </div>
            <div class="route-card">
              <h3>From Yaba</h3>
              <ol>{directions.fromYaba.map((t) => <li>{t}</li>)}</ol>
            </div>
            <div class="route-card route-card--then">
