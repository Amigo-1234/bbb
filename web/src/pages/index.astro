          <a class="btn btn--on-red" href={whatsapp} rel="noopener" target="_blank" data-cta="home-apply-whatsapp">WhatsApp</a>
          <a class="btn btn--on-red" href="#location" data-cta="home-apply-directions"><Icon name="pin" size={18} />Directions</a>
