---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import Laurel from '../components/Laurel.astro';
import Badge from '../components/Badge.astro';
import CbtPromo from '../components/CbtPromo.astro';
import { getImage } from 'astro:assets';
import { directions, directionsCaptions, founder as founderInfo, mission, routeCaption } from '../data/identity';
import { programmes, tutorialPackage } from '../data/fees';
import AchieverCard from '../components/AchieverCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { achievers } from '../data/achievements';
import { testimonials } from '../data/testimonials';
import poster from '../assets/official/directions-poster.jpg';
import {
  admissionsByInstitution,
  address,
  calendar,
  contacts,
  faqs,
  registration,
  naira,
  primaryContact,
  site,
  whatsapp,
} from '../data/site';
import founder from '../assets/photos/founder.png';
import founderTeaching from '../assets/photos/founder-teaching.jpg';
import centre from '../assets/photos/centre-entrance.jpg';
import LifeGallery from '../components/LifeGallery.astro';
import { heroPhotos, lifePhotos, tutorPhoto } from '../data/media';
// The hero uses one photograph as a full-bleed background (the widest, most open classroom shot).
const heroPhoto = heroPhotos[0];
import { gallery } from '../data/gallery';
const galleryCount = { photos: gallery.filter((g) => g.kind === 'photo').length, videos: gallery.filter((g) => g.kind === 'video').length };

const tz = { timeZone: 'Africa/Lagos' } as const;
const d = (s: string) => new Date(s + 'T12:00:00Z');
const full = (s: string) => d(s).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', ...tz });

const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
const posterImg = await getImage({ src: poster, format: 'webp', width: 464 });
const fmtCap = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
// Hall of Excellence band: consented achievers first (sorted in data/achievements.ts).
const homeAchievers = achievers;
---

<Base
  motion
  overlayHeader
  title="BIA JUPEB — Boma’s Intellectual Academy, Akoka, Lagos | JUPEB & Direct Entry into 200 Level"
  description="Prepare for JUPEB with BIA JUPEB: Boma’s Intellectual Academy’s 8–9 month Science and Non-Science programme in Akoka, Lagos and online, with weekly tests, tutorials and Direct Entry admission guidance."
>

  <!-- HERO: full-bleed classroom photograph with the copy laid over it -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <figure class="hero__bg" data-clip>
      <Picture
        src={heroPhoto.src}
        formats={formats}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        alt={heroPhoto.alt}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <figcaption class="hero__caption">{heroPhoto.caption}</figcaption>
    </figure>

    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow with-icon hero__eyebrow"><Icon name="pin" size={16} />Boma’s Intellectual Academy · Akoka, Lagos &amp; online</p>
        <h1 id="hero-title" class="hero__title">
          Your direct route to <em>200&nbsp;Level.</em>
        </h1>
        <p class="lead hero__lead">
          An {site.programmeLength.replace('months', 'month')} JUPEB programme for Science and Non-Science students — in class near UNILAG and online.
        </p>
        <div class="hero__ctas" data-cta-zone>
          <a class="btn hero__primary" href="#apply" data-cta="home-hero-enquire">Enquire about JUPEB admission<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--on-ink hero__secondary" href="#success" data-cta="home-hero-achievers"><Laurel size={18} class="hero__laurel" />See our AAA achievers</a>
        </div>
        <a class="hero__call" href={`tel:${primaryContact.phone}`} data-cta="home-hero-call">
          <span class="hero__call-icon"><Icon name="phone" size={18} /></span>
          <span>
            <span class="hero__call-label">Speak to admissions</span>
            <span class="hero__call-num num">{primaryContact.display}</span>
          </span>
        </a>
      </div>

      <div class="hero__inset hero__seal">
        <Badge variant="seal" size={150} label="Official badge of Boma’s Intellectual Academy (BIA)" />
      </div>
    </div>
  </section>

  <!-- 01 HALL OF EXCELLENCE (main attraction) -->
  <section class="section section--ink honours" id="success" aria-labelledby="outcomes">
    <svg class="honours__mark" viewBox="0 0 400 400" aria-hidden="true" data-clip>
      <text x="200" y="330" text-anchor="middle">A</text>
    </svg>
    <div class="wrap">
      <header class="hall__head">
        <Laurel class="hall__laurel" size={72} />
        <p class="hall__eyebrow">BIA JUPEB Hall of Excellence</p>
        <h2 id="outcomes" class="hall__title">16 Points <em>(AAA)</em> Achievers</h2>
        <p class="hall__lead">Straight As in JUPEB — and straight into 200 Level. Meet the students who did it with BIA.</p>
      </header>

      <Carousel label="BIA JUPEB AAA achievers" variant="cards" tone="ink" class="hall__carousel">
        {homeAchievers.map((a) => <div data-slide class="hall__slide"><AchieverCard achiever={a} /></div>)}
      </Carousel>

      <div class="hall__foot">
        <ul class="hall__stats" role="list">
          <li><strong class="num">{achievers.length}</strong> AAA results recorded</li>
          {admissionsByInstitution.length > 0 && <li>Admissions recorded at {admissionsByInstitution.map((a) => a.institution).join(', ')}</li>}
        </ul>
        <div class="hall__ctas">
          <a class="btn btn--brass" href="/hall-of-excellence" data-cta="home-hall">Enter the Hall of Excellence<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--on-ink" href="/success-stories" data-cta="home-success-stories">All results &amp; admissions</a>
        </div>
      </div>
      <p class="honours__note">Names and photographs appear only with each student’s written permission.</p>
    </div>
  </section>

  <!-- 02 TESTIMONIALS (shown only when consented testimonials exist) -->
  {testimonials.length > 0 && (
    <section class="section voices" id="testimonials" aria-labelledby="voices-title">
      <div class="wrap">
        <header class="voices__head">
          <p class="eyebrow">In their own words</p>
          <h2 id="voices-title" class="voices__title">What our students say.</h2>
        </header>
        <ul class="voices__grid" role="list" data-voices>
          {testimonials.slice(0, 3).map((t) => <li><TestimonialCard t={t} /></li>)}
        </ul>
        <a class="link-arrow" href="/success-stories#voices" data-cta="home-testimonials-more">More success stories<Icon name="arrow-right" size={16} /></a>
      </div>
    </section>
  )}

  <!-- 03 ADMISSIONS ESSENTIALS -->
  <section class="section section--tint ess" id="programme" aria-labelledby="ess-title">
    <div class="wrap">
      <header class="ess__head">
        <p class="eyebrow">Admissions · {site.session} session</p>
        <h2 id="ess-title" class="ess__title">Everything you need to <em>start.</em></h2>
        <p class="ess__lead">An {site.programmeLength.replace('months', 'month')} JUPEB programme for Science and Non-Science students — in class in Akoka, near UNILAG, and online — leading to Direct Entry into 200 Level.</p>
      </header>

      <ul class="ess__cards" role="list">
        <li class="ess__card ess__card--red">
          <p class="ess__k">Registration</p>
          <p class="ess__v num" data-registration>{naira(registration.amount)}</p>
          <p class="ess__s">Application form · non-refundable</p>
        </li>
        <li class="ess__card">
          <p class="ess__k">Programme fees</p>
          <p class="ess__v num">{naira(programmes.find((x) => x.id === 'science')!.total)}</p>
          <p class="ess__s">Science total · Non-Science: ask admissions</p>
          <a class="ess__link" href="/fees" data-cta="home-ess-fees">Full fees<Icon name="arrow-right" size={16} /></a>
        </li>
        <li class="ess__card" id="tutorials">
          <p class="ess__k">Physical tutorials only</p>
          <p class="ess__v num">{naira(tutorialPackage.monthly.amount)}<small>/month</small></p>
          <p class="ess__s">or {naira(tutorialPackage.oneTime.amount)} one-time</p>
          <a class="ess__link" href="/fees#tutorials" data-cta="home-ess-tutorials">Tutorial package<Icon name="arrow-right" size={16} /></a>
        </li>
        <li class="ess__card">
          <p class="ess__k">How you study</p>
          <p class="ess__v ess__v--text">Physical &amp; online</p>
          <p class="ess__s">Lectures, weekly tests, marathon classes</p>
          <a class="ess__link" href="/timetable" data-cta="home-ess-timetable">Class timetable<Icon name="arrow-right" size={16} /></a>
        </li>
      </ul>

      <div class="ess__grid">
        <div class="ess__block">
          <h3 class="ess__h">How it works</h3>
          <ol class="ess__steps">
            <li><strong>Register</strong> with BIA and choose your subject combination.</li>
            <li><strong>Study</strong> for {site.programmeLength} — physical or online.</li>
            <li><strong>Sit JUPEB</strong> and earn your grades.</li>
            <li><strong>Apply for Direct Entry</strong> into 200 Level, with BIA’s guidance.</li>
          </ol>
        </div>
        <div class="ess__block">
          <h3 class="ess__h">To register you need</h3>
          <ul class="ess__req">{registration.requirements.map((r) => <li><Icon name="check" size={18} />{r}</li>)}</ul>
        </div>
        <div class="ess__block" id="calendar">
          <h3 class="ess__h">Key dates</h3>
          <ul class="ess__dates">
            {calendar.map((c) => (
              <li>
                <span class="ess__date num">{full(c.start)}{c.end ? ` – ${full(c.end)}` : ''}</span>
                <span>{c.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 LIFE AT BIA -->
  <section class="section section--tint gallery" id="life" aria-labelledby="inside">
    <div class="wrap">
      <SectionHead index="03" eyebrow="Life at BIA" title="Real classes. Real tutors. Real work." id="inside">
        <p>A look inside Boma’s Intellectual Academy — tap any photograph to see it full size.</p>
      </SectionHead>
      <LifeGallery photos={lifePhotos} label="Photographs from BIA classes" />
      <a class="explore" href="/gallery" data-cta="home-explore-gallery">
        <span class="explore__text">
          <span class="explore__kicker">Gallery</span>
          <span class="explore__title">Explore Life at BIA</span>
          <span class="explore__meta num">{galleryCount.photos} photographs · {galleryCount.videos} videos</span>
        </span>
        <span class="explore__arrow" aria-hidden="true"><Icon name="arrow-right" size={26} /></span>
      </a>
    </div>
  </section>

  <!-- 05 FOUNDER -->
  <section class="section fsec" id="founder" aria-labelledby="people">
    <div class="wrap">
      <SectionHead index="04" eyebrow="Founder & leadership" title="Boma’s Intellectual Academy, led by its founder." id="people" />

      <div class="people">
        <figure class="founder" data-clip>
          <Picture
            src={founder}
            formats={formats}
            widths={[360, 640]}
            sizes="(min-width: 960px) 34vw, 90vw"
            alt={`${founderInfo.name}, founder of Boma’s Intellectual Academy`}
          />
          <Badge variant="seal" size={112} class="founder__seal" />
          <figcaption>
            <span class="founder__name">{founderInfo.name}</span>
            <span class="founder__aka">{founderInfo.fullName}</span>
          </figcaption>
        </figure>

        <div class="people__side">
          <p class="founder__role">{founderInfo.role}.</p>
          <p class="founder__bio">{founderInfo.bio}</p>
          <p class="founder__note">{founderInfo.nameNote}</p>
          <blockquote class="mission">
            <svg class="mission__mark" viewBox="0 0 48 36" aria-hidden="true">
              <path d="M0 36V20C0 8 7 1 19 0v7c-6 1-10 5-10 12h10v17Zm29 0V20C29 8 36 1 48 0v7c-6 1-10 5-10 12h10v17Z" />
            </svg>
            <p>{mission}</p>
            <footer>BIA’s mission</footer>
          </blockquote>

          <figure class="moment">
            <Picture
              src={founderTeaching}
              formats={formats}
              widths={[320, 560]}
              sizes="(min-width: 960px) 18vw, 40vw"
              alt="Boma speaking to students with a microphone"
              style="object-position:center 25%"
            />
            <figcaption>
              <strong>Hands-on leadership.</strong> Boma speaks to students in person, and his line —
              {primaryContact.display} — is the admissions number on every official BIA document.
            </figcaption>
          </figure>

          {tutorPhoto && (
            <figure class="moment moment--tutor">
              <Picture src={tutorPhoto.src} formats={formats} widths={[320, 560]} sizes="(min-width: 960px) 18vw, 40vw" alt={tutorPhoto.alt} style={tutorPhoto.position ? `object-position:${tutorPhoto.position}` : undefined} />
              <figcaption><strong>Our tutors.</strong> {tutorPhoto.caption}.</figcaption>
            </figure>
          )}

          <div class="team">
            <h3 class="team__title">Speak to admissions</h3>
            <ul class="team__list">
              {contacts.map((c) => (
                <li>
                  <span>
                    <span class="team__name">{c.name ?? c.role}</span>
                    {c.name && <span class="team__role">{c.role}</span>}
                  </span>
                  <a class="team__tel num" href={`tel:${c.phone}`} data-cta={`home-founder-call-${c.phone.slice(-4)}`}><Icon name="phone" size={16} />{c.display}</a>
                </li>
              ))}
            </ul>
            <a class="team__more" href="/contact" data-cta="home-founder-contact">All staff contacts &amp; our two offices<Icon name="arrow-right" size={16} /></a>
            <a class="team__more" href="/team" data-cta="home-founder-team">Meet our team<Icon name="arrow-right" size={16} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 LOCATION -->
  <section class="section loc" id="location" aria-labelledby="location-title">
    <div class="wrap">
      <SectionHead index="05" eyebrow="Location & directions" title="Find us at 12 Ameen Street, Akoka." id="location-title" tone="ink">
        <p>Our tutorial centre is a short walk from the University of Lagos. Watch BIA’s own directions video, or follow the written steps.</p>
      </SectionHead>

      <div class="loc__grid">
        <div class="loc__info">
          <address class="loc__address">
            <span class="loc__name">{address.name}</span>
            {address.lines.map((l) => <span class="loc__line">{l}</span>)}
            <span class="loc__landmark"><Icon name="pin" size={16} />Landmark: {address.landmark}</span>
          </address>
          <div class="loc__ctas" data-cta-zone>
            {contacts.map((c) => (
              <a class="btn" href={`tel:${c.phone}`} data-cta={`home-location-call-${c.phone.slice(-4)}`}><Icon name="phone" size={18} />Call {c.display}</a>
            ))}
            <a class="btn btn--on-ink" href={whatsapp} rel="noopener" target="_blank" data-cta="home-location-whatsapp">WhatsApp admissions</a>
            <a class="btn btn--on-ink" href={address.mapsUrl} rel="noopener" target="_blank" data-cta="home-location-map"><Icon name="pin" size={18} />Open in Google Maps</a>
          </div>

          <details class="loc__routes">
            <summary>Written directions from UNILAG and Yaba</summary>
          <div class="routes">
            <div class="route-card">
              <h3>From the University of Lagos</h3>
              <ol>{directions.fromUnilag.map((t) => <li>{t}</li>)}</ol>
            </div>
            <div class="route-card">
              <h3>From Yaba</h3>
              <ol>{directions.fromYaba.map((t) => <li>{t}</li>)}</ol>
            </div>
            <div class="route-card route-card--then">
              <h3>Then</h3>
              <ol>{directions.then.map((t) => <li>{t}</li>)}</ol>
            </div>
          </div>
          <p class="loc__caption"><strong>Route shown on screen:</strong> {routeCaption}</p>
          </details>
        </div>

        <div class="loc__media">
          <figure class="loc__video">
            <video
              controls
              playsinline
              preload="none"
              data-poster={posterImg.src}
              width="464"
              height="832"
              aria-describedby="video-desc"
            >
              <source src="/media/bia-directions.mp4" type="video/mp4" />
              <track kind="captions" src="/media/bia-directions.en.vtt" srclang="en" label="English" />
              <a href="/media/bia-directions.mp4">Download the directions video (MP4, 7.5 MB)</a>
            </video>
            <figcaption id="video-desc">
              BIA’s directions video, from UNILAG and Yaba to the centre · 1 min 23 s · captions shown on screen.
              Filmed by BIA (TikTok @bomaacademylimited).
            </figcaption>
          </figure>
          <figure class="loc__gate">
            <Picture
              src={centre}
              formats={formats}
              widths={[480, 800]}
              sizes="(min-width: 960px) 30vw, 100vw"
              alt="The gate at 12 Ameen Street, Abule-Oja, beside the Seventh Day Adventist Primary School sign"
            />
            <figcaption>You have arrived: the gate at 12 Ameen Street, by the Seventh Day Adventist school sign.</figcaption>
          </figure>
        </div>
      </div>

      <details class="loc__transcript">
        <summary>Read the video transcript</summary>
        <ol>
          {directionsCaptions.map(([a, , t]) => (
            <li><span class="num">{fmtCap(a)}</span> {t}</li>
          ))}
        </ol>
      </details>
    </div>
  </section>

  <!-- CBT PRACTICE PLATFORM -->
  <section class="section cbt-band" id="cbt" aria-label="CBT practice platform">
    <div class="wrap"><CbtPromo source="home" /></div>
  </section>

  <!-- 07 FAQ -->
  <section class="section section--tint" aria-labelledby="faq">
    <div class="wrap faq">
      <SectionHead index="06" eyebrow="Questions" title="What applicants ask us most." id="faq" />
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLY / VISIT -->
  <section class="apply" id="apply" aria-labelledby="apply-title" data-cta-zone>
    <Badge variant="mark" size={560} class="apply__watermark" />
    <div class="wrap apply__grid">
      <div class="apply__copy">
        <p class="eyebrow apply__eyebrow">Apply · {site.session}</p>
        <h2 id="apply-title" class="apply__title">Enquire about <em>admission.</em></h2>
        <p class="apply__lead">
          Registration is handled by the BIA admissions office. Call or WhatsApp to begin, or visit the centre with your
          O'Level result (or awaiting result), NIN and birth certificate. The registration fee is {naira(registration.amount)}.
        </p>
        <div class="apply__ctas">
          <a class="btn btn--white" href={`tel:${primaryContact.phone}`} data-cta="home-apply-call"><Icon name="phone" size={18} />Speak to admissions · {primaryContact.display}</a>
          <a class="btn btn--on-red" href={whatsapp} rel="noopener" target="_blank" data-cta="home-apply-whatsapp">WhatsApp</a>
          <a class="btn btn--on-red" href="#location" data-cta="home-apply-directions"><Icon name="pin" size={18} />Directions</a>
        </div>
      </div>

      <div class="apply__card">
        <Badge variant="seal" size={120} tone="ink" />
        <address>
          <span class="apply__place">{address.name}</span>
          {address.lines.map((l) => <span>{l}</span>)}
        </address>
        <ul class="apply__tels">
          {contacts.map((c) => <li><a class="num" href={`tel:${c.phone}`} data-cta={`home-apply-tel-${c.phone.slice(-4)}`}>{c.display}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initHomeMotion } from '../scripts/motion/home';
  initHomeMotion();

  // Below-the-fold video posters: set only when the video approaches the viewport.
  const lazyPosters = document.querySelectorAll<HTMLVideoElement>('video[data-poster]');
  const setPoster = (v: HTMLVideoElement) => (v.poster = v.dataset.poster!);
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { setPoster(e.target as HTMLVideoElement); io.unobserve(e.target); }
    }, { rootMargin: '600px 0px' });
    lazyPosters.forEach((v) => io.observe(v));
  } else lazyPosters.forEach(setPoster);
</script>

<style>
  .section {
    padding-block: var(--section);
  }
  .section--tint {
    background: var(--paper-2);
  }
  .section--ink {
    background: var(--ink);
    color: var(--on-ink);
  }

  /* ---------- Hero: full-bleed photograph ---------- */
  .hero {
    --hero-fg: #fff;
    --hero-fg-2: rgb(255 255 255 / 0.86);
    --hero-muted: rgb(255 255 255 / 0.74);
    position: relative;
    isolation: isolate;
    display: grid;
    /* Fill the first screen below the notice bar, within sensible limits. */
    min-height: clamp(600px, 100svh - 36px, 940px);
    /* Slide under the transparent sticky header. */
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + var(--s-7));
    padding-bottom: var(--s-7);
    overflow: hidden;
    background: var(--ink);
    color: var(--hero-fg);
  }
  .hero :focus-visible {
    outline-color: #fff;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
  }
  .hero__bg :global(picture),
  .hero__bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__bg :global(img) {
    object-fit: cover;
    /* Mobile: keep the full class and the tutor in frame. */
    object-position: 62% 50%;
  }
  /* Readability: deep at the bottom (where the copy sits on phones) and under the header. */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(13 14 19 / 0.62) 0%, rgb(13 14 19 / 0) 22%),
      linear-gradient(180deg, rgb(13 14 19 / 0) 22%, rgb(13 14 19 / 0.72) 52%, rgb(13 14 19 / 0.94) 100%);
  }
  .hero__caption {
    display: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    align-items: end;
  }
  .hero__copy {
    display: grid;
    gap: var(--s-4);
    max-width: 40rem;
  }
  .hero__eyebrow {
    color: var(--hero-muted);
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.8rem + 4vw, 5.4rem);
    font-weight: 380;
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 10ch;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }
  /* BIA-red underline instead of crimson text: crimson is too dark to read on the photograph. */
  .hero__title em {
    font-weight: 400;
    background: linear-gradient(var(--bia-red), var(--bia-red)) 0 92% / 100% 0.08em no-repeat;
    padding-bottom: 0.02em;
  }
  .hero__lead {
    color: var(--hero-fg-2);
  }
  .hero__ctas .btn {
    white-space: normal;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .hero__primary {
    --_bg: var(--bia-red);
    --_bd: var(--bia-red);
  }
  .hero__primary:hover {
    --_bg: var(--bia-red-deep);
    --_bd: var(--bia-red-deep);
  }
  .hero__secondary {
    --_bd: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero__secondary:hover {
    --_bd: #fff;
    background: rgb(255 255 255 / 0.16);
  }
  .hero__call {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    width: fit-content;
    text-decoration: none;
  }
  .hero__call-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    transition: background-color 0.2s var(--ease);
  }
  .hero__call > span:last-child {
    display: grid;
    line-height: 1.25;
  }
  .hero__call-label {
    font-size: var(--step--1);
    color: var(--hero-muted);
  }
  .hero__call-num {
    font-weight: 700;
  }
  .hero__call:hover .hero__call-icon {
    background: var(--bia-red);
    border-color: var(--bia-red);
  }

  .hero__inset {
    display: none;
    filter: drop-shadow(0 12px 24px rgb(0 0 0 / 0.4));
  }
  .hero__inset :global(svg) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 599px) {
    .hero__ctas .btn {
      flex: 1 1 100%;
    }
  }

  /* Phones and tablets: the photograph is landscape, so the class sits in its lower half.
     The copy goes over the calm ceiling and wall at the top; the students stay visible below.
     The shade is tied to the copy's own height, so it always covers the text whatever it wraps to. */
  @media (max-width: 959px) {
    .hero {
      padding-top: calc(var(--header-h) + var(--s-6));
    }
    .hero__inner {
      align-items: start;
    }
    .hero__bg::after {
      background:
        linear-gradient(180deg, rgb(13 14 19 / 0.5) 0%, rgb(13 14 19 / 0.1) 30%),
        linear-gradient(0deg, rgb(13 14 19 / 0.55) 0%, rgb(13 14 19 / 0) 22%);
    }
    .hero__copy {
      position: relative;
    }
    .hero__copy::before {
      content: '';
      position: absolute;
      z-index: -1;
      /* full width of the screen (the hero clips the overflow), from the top of the hero to below the copy */
      inset: calc(-1 * (var(--header-h) + var(--s-7))) auto -7rem calc(-1 * var(--gutter));
      width: 100vw;
      background: linear-gradient(
        180deg,
        rgb(13 14 19 / 0.62) 0%,
        rgb(13 14 19 / 0.7) 30%,
        rgb(13 14 19 / 0.8) calc(100% - 9rem),
        rgb(13 14 19 / 0.55) calc(100% - 4.5rem),
        rgb(13 14 19 / 0) 100%
      );
      pointer-events: none;
    }
  }

  /* Tablet and up: the official seal sits on the photograph, bottom right. */
  @media (min-width: 600px) {
    .hero__inset {
      display: block;
      position: absolute;
      right: var(--gutter);
      bottom: 0;
      width: 104px;
    }
  }

  /* Desktop: copy on the left over a side-to-side shade; the class stays visible on the right. */
  @media (min-width: 960px) {
    .hero {
      padding-bottom: var(--s-8);
    }
    .hero__inner {
      align-items: center;
    }
    .hero__bg :global(img) {
      object-position: 58% 45%;
    }
    .hero__bg::after {
      background:
        linear-gradient(180deg, rgb(13 14 19 / 0.6) 0%, rgb(13 14 19 / 0) 20%),
        linear-gradient(90deg, rgb(13 14 19 / 0.9) 0%, rgb(13 14 19 / 0.74) 32%, rgb(13 14 19 / 0.28) 62%, rgb(13 14 19 / 0.06) 100%),
        linear-gradient(0deg, rgb(13 14 19 / 0.6) 0%, rgb(13 14 19 / 0) 30%);
    }
    .hero__caption {
      display: block;
      position: absolute;
      z-index: 1; /* above the shade */
      right: max(var(--gutter), (100vw - var(--max)) / 2);
      bottom: var(--s-5);
      padding-left: var(--s-3);
      border-left: 2px solid var(--bia-red);
      font-size: var(--step--1);
      font-weight: 600;
      color: #fff;
      text-shadow: 0 1px 12px rgb(0 0 0 / 0.7);
    }
    /* Seal stacks above the caption, both on the content edge. */
    .hero__inset {
      width: 132px;
    }
  }
  @media (min-width: 1200px) {
    .hero__inset {
      width: 150px;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: var(--s-8) 0 0;
    border-top: 1px solid var(--ink);
  }
  .facts > div {
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .facts > div:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .facts > div:nth-child(even) {
    padding-left: var(--s-4);
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: var(--s-1) 0 0;
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .facts small {
    display: block;
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 2px;
  }

  @media (min-width: 960px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
    .facts > div,
    .facts > div:nth-child(even) {
      padding: var(--s-5);
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .facts > div:first-child {
      padding-left: 0;
    }
    .facts > div:last-child {
      border-right: 0;
    }
  }


  /* ---------- Hall of Excellence band (homepage main attraction) ---------- */
  .honours {
    padding-block: var(--s-8) var(--s-8);
  }
  .hall__head {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    text-align: center;
    margin-bottom: var(--s-6);
  }
  .hall__head :global(.hall__laurel) {
    color: var(--brass-light);
  }
  .hall__eyebrow {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-light);
  }
  .hall__title {
    font-size: var(--step-4);
    font-weight: 380;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hall__title em {
    color: var(--brass-light);
  }
  .hall__lead {
    max-width: 38ch;
    color: var(--on-ink-muted);
  }
  /* Achiever carousel (V2 Carousel, "cards" variant): bleeds to the screen edge on phones */
  .hall__head + :global(.hall__carousel) {
    margin-top: var(--s-2);
  }
  .hall__slide {
    display: flex;
  }
  .hall__slide > :global(*) {
    flex: 1;
  }
  :global(.hall__carousel .carousel__btn) {
    border-color: rgb(214 182 121 / 0.45);
    color: #fff;
  }
  :global(.hall__carousel .carousel__btn:not(:disabled):hover) {
    background: var(--brass-light);
    border-color: var(--brass-light);
    color: var(--ink);
  }
  .hall__foot {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }
  .hall__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hall__stats li {
    padding: 6px 14px;
    border: 1px solid rgb(214 182 121 / 0.35);
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .hall__stats strong {
    color: var(--brass-light);
  }
  .hall__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .hall__ctas .btn {
    white-space: normal;
  }
  .btn--brass {
    background: var(--brass-light);
    border-color: var(--brass-light);
    color: var(--ink);
  }
  .btn--brass:hover {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }
  @media (min-width: 960px) {
    .hall__foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  /* ---------- Testimonials ---------- */
  .voices {
    padding-block: var(--s-8);
  }
  .voices__head {
    margin-bottom: var(--s-5);
  }
  .voices__title {
    font-size: var(--step-3);
  }
  .voices__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-5);
    padding: 0;
    list-style: none;
  }

  /* ---------- Admissions essentials ---------- */
  .ess {
    padding-block: var(--s-8);
  }
  .ess__head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }
  .ess__title {
    font-size: var(--step-3);
  }
  .ess__title em {
    color: var(--crimson);
  }
  .ess__lead {
    max-width: 60ch;
    color: var(--muted);
  }
  .ess__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ess__card {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: var(--s-4);
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h, 64px) + 16px);
  }
  .ess__card--red {
    background: var(--bia-red);
    border-color: var(--bia-red);
    color: #fff;
  }
  .ess__card--red .ess__k,
  .ess__card--red .ess__s {
    color: var(--on-red-muted);
  }
  .ess__k {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ess__v {
    font-family: var(--serif);
    font-size: clamp(1.45rem, 1.2rem + 1vw, 2rem);
    line-height: 1.1;
  }
  .ess__v small {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .ess__v--text {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
  }
  .ess__s {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ess__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: auto;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .ess__grid {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }
  .ess__block {
    scroll-margin-top: calc(var(--header-h, 64px) + 16px);
  }
  .ess__h {
    font-size: var(--step-1);
    margin-bottom: var(--s-3);
  }
  .ess__steps {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding-left: 1.3em;
  }
  .ess__req {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ess__req li {
    display: flex;
    gap: var(--s-2);
  }
  .ess__req :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--crimson);
  }
  .ess__dates {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ess__dates li {
    display: grid;
    padding-left: var(--s-3);
    border-left: 3px solid var(--crimson);
  }
  .ess__date {
    font-weight: 800;
  }
  @media (min-width: 840px) {
    .ess__cards {
      grid-template-columns: repeat(4, 1fr);
    }
    .ess__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-7);
    }
  }

  /* Location: written routes collapse behind the video */
  .loc__routes summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--s-4);
    font-weight: 700;
    cursor: pointer;
  }
  .hero__ctas :global(.hero__laurel) {
    color: var(--brass-light); /* honours mark on the dark photograph */
  }

  /* ---------- Honours ---------- */
  .honours {
    position: relative;
    overflow: hidden;
  }
  .honours__mark {
    position: absolute;
    right: -6%;
    top: -4%;
    width: min(70vw, 620px);
    pointer-events: none;
  }
  .honours__mark text {
    font-family: var(--serif);
    font-size: 420px;
    font-style: italic;
    fill: none;
    stroke: rgb(255 255 255 / 0.07);
    stroke-width: 1.2;
  }
  .honours .wrap {
    position: relative;
  }
  .honours__grid {
    display: grid;
    gap: var(--s-7);
  }
  .honours__grid > * {
    min-width: 0;
  }
  .congrats {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    border: 1px solid rgb(214 182 121 / 0.35);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 80% at 50% 0%, rgb(214 182 121 / 0.12), transparent 60%),
      rgb(255 255 255 / 0.02);
    text-align: center;
    justify-items: center;
  }
  .congrats :global(.congrats__laurel) {
    width: 104px;
    color: var(--brass-light);
  }
  .congrats__kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .congrats__title {
    font-size: clamp(2.6rem, 1.8rem + 3vw, 3.6rem);
    font-style: italic;
    font-weight: 380;
    color: var(--brass-light);
  }
  .congrats__text {
    max-width: 30ch;
    color: var(--on-ink);
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.35;
  }
  .congrats__unis {
    width: 100%;
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .congrats__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .congrats__unis ul {
    display: grid;
    gap: var(--s-1);
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--serif);
    font-size: var(--step-1);
  }
  .congrats__ctas {
    display: grid;
    gap: var(--s-2);
    width: 100%;
    margin-top: var(--s-4);
  }
  .congrats__ctas .btn {
    white-space: normal;
    text-align: center;
  }
  @media (min-width: 960px) {
    .honours__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-7);
      align-items: start;
    }
  }
  .result {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-5) var(--s-6);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 2px solid var(--brass-light);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.03);
    min-height: 100%;
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), background-color 0.35s var(--ease);
  }
  .result:hover {
    transform: translateY(-4px);
    border-color: rgb(214 182 121 / 0.45);
    background: rgb(255 255 255 / 0.05);
  }
  .result__top {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .result__level {
    color: var(--brass-light);
  }
  .result__grade {
    display: flex;
    gap: 0.08em;
    margin-top: var(--s-3);
    font-family: var(--serif);
    font-size: clamp(4rem, 3rem + 4vw, 5.5rem);
    font-weight: 380;
    line-height: 1;
    color: var(--brass-light);
    overflow: hidden;
    padding-block: 0.06em;
  }
  .result__course {
    margin-top: var(--s-3);
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .result__inst {
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .honours__note {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }

  /* ---------- Phase 6 photography ---------- */
  .band {
    position: relative;
    margin: 0;
  }
  .band :global(img) {
    display: block;
    width: 100%;
    height: clamp(240px, 52vw, 620px);
    object-fit: cover;
  }
  .band figcaption {
    position: absolute;
    inset: auto 0 var(--s-5) 0;
  }
  .band figcaption span {
    display: inline-block;
    max-width: 28ch;
    padding: var(--s-3) var(--s-4);
    background: var(--bia-red);
    color: #fff;
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.25;
    border-radius: var(--radius);
  }
  .mode__photo {
    margin: 0 0 var(--s-2);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .mode__photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .explore {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-5);
    padding: var(--s-5) var(--s-6);
    background: var(--bia-red);
    color: #fff;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }
  .explore:hover,
  .explore:focus-visible {
    background: var(--bia-red-deep);
  }
  .explore__text {
    display: grid;
    gap: 2px;
  }
  .explore__kicker {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-red-muted);
  }
  .explore__title {
    font-family: var(--serif);
    font-size: var(--step-3);
    line-height: 1.05;
  }
  .explore__meta {
    font-size: var(--step--1);
    color: var(--on-red-muted);
  }
  .explore__arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: var(--bia-red);
    transition: transform 0.25s var(--ease);
  }
  .explore:hover .explore__arrow {
    transform: translateX(4px);
  }
  .lessons {
    margin-top: var(--s-8);
    padding: var(--s-6) var(--s-5);
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--radius);
  }
  .lessons__title {
    margin-bottom: var(--s-4);
    font-size: var(--step-2);
    color: #fff;
  }
  .moment--tutor {
    margin-top: calc(-1 * var(--s-4));
  }

  /* ---------- Gallery ---------- */
  .shot figure {
    margin: 0;
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .shot figcaption {
    margin-top: var(--s-3);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }

  /* ---------- People ---------- */
  .people {
    display: grid;
    gap: var(--s-8);
  }
  .founder {
    position: relative;
    margin: 0;
  }
  .founder :global(.founder__seal) {
    position: absolute;
    right: calc(-1 * var(--s-3));
    top: calc(-1 * var(--s-5));
    width: 112px;
    height: auto;
    filter: drop-shadow(0 10px 20px rgb(21 23 30 / 0.3));
  }
  .fsec .people {
    position: relative;
    isolation: isolate;
  }
  .moment {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--s-4);
    align-items: center;
    margin: 0;
    padding: var(--s-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .moment :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
  }
  .moment figcaption {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .founder :global(picture) {
    display: block;
    margin: 0 var(--s-4) var(--s-4) 0;
    box-shadow: var(--s-4) var(--s-4) 0 var(--bia-red);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .founder :global(img) {
    width: 100%;
